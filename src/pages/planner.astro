---
import { supabase, createRequestClient, decodeAccessToken } from '../lib/supabase';
import SignOut from '../components/SignOut.astro';
import BottomNav from '../components/BottomNav.astro';

// --- 1. AUTHENTICATION GUARD ---
const accessToken = Astro.cookies.get('sb-access-token')?.value;
const refreshToken = Astro.cookies.get('sb-refresh-token')?.value;

if (!accessToken || !refreshToken) {
  return Astro.redirect('/login');
}

const claims = decodeAccessToken(accessToken);
const nowSeconds = Date.now() / 1000;

let user: { id: string; email?: string };
let sessionAccessToken = accessToken;

if (claims?.exp && claims.exp > nowSeconds + 30) {
  // Token is still valid — skip the network round trip to Supabase's Auth API.
  user = { id: claims.sub, email: claims.email };
} else {
  // Expired (or undecodable) — refresh via a scoped client, never the shared singleton.
  let refreshData, refreshError;
  try {
    ({ data: refreshData, error: refreshError } = await createRequestClient().auth.refreshSession({
      refresh_token: refreshToken,
    }));
  } catch (e) {
    console.error('PLANNER_PAGE_SUPABASE_ERROR:', e);
    // This error is likely due to server misconfiguration (missing env vars).
    // Clear cookies and redirect to login to prevent a redirect loop.
    Astro.cookies.delete('sb-access-token', { path: '/' });
    Astro.cookies.delete('sb-refresh-token', { path: '/' });
    return Astro.redirect('/login?error=Server configuration error.');
  }

  if (refreshError || !refreshData.session || !refreshData.user) {
    Astro.cookies.delete('sb-access-token', { path: '/' });
    Astro.cookies.delete('sb-refresh-token', { path: '/' });
    return Astro.redirect('/login');
  }

  const { access_token, refresh_token, expires_in } = refreshData.session;
  sessionAccessToken = access_token;
  user = refreshData.user;

  Astro.cookies.set('sb-access-token', access_token, {
    path: '/',
    maxAge: Math.round(expires_in),
    sameSite: 'lax',
    secure: import.meta.env.PROD,
  });
  Astro.cookies.set('sb-refresh-token', refresh_token, {
    path: '/',
    maxAge: 60 * 60 * 24 * 30, // 30 days
    sameSite: 'lax',
    secure: import.meta.env.PROD,
  });
}

const db = createRequestClient(sessionAccessToken);
// --- 2. CALENDAR & NAVIGATION LOGIC ---
const urlMonth = Astro.url.searchParams.get('month');
const urlYear = Astro.url.searchParams.get('year');

const now = new Date();
const currentYear = urlYear !== null ? parseInt(urlYear) : now.getFullYear();
const currentMonth = urlMonth !== null ? parseInt(urlMonth) : now.getMonth();

const prevMonth = currentMonth === 0 ? 11 : currentMonth - 1;
const prevYear = currentMonth === 0 ? currentYear - 1 : currentYear;
const nextMonth = currentMonth === 11 ? 0 : currentMonth + 1;
const nextYear = currentMonth === 11 ? currentYear + 1 : currentYear;

const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
const firstDayIndex = new Date(currentYear, currentMonth, 1).getDay();
const monthName = new Date(currentYear, currentMonth, 1).toLocaleString('default', { month: 'long' });

const isCurrentMonth = now.getMonth() === currentMonth && now.getFullYear() === currentYear;
const defaultDate = isCurrentMonth 
  ? now.toISOString().split('T')[0] 
  : `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-01`;

// --- 3. DATA FETCHING (USER & MONTH SPECIFIC) ---
const firstDayOfMonth = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-01`;
const lastDayOfMonth = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(daysInMonth).padStart(2, '0')}`;

const { data: viewedMonthLogs } = await db
  .from('planner_logs')
  .select('*')
  // .eq('user_id', user.id) // This filter is now handled by RLS, but can be kept for clarity.
  .gte('date', firstDayOfMonth)
  .lte('date', lastDayOfMonth)
  .order('date', { ascending: false });

// --- 4. CALCULATE TOTALS ---
const hoursByDay: Record<number, { actual: number, planned: number }> = {};
let monthActual = 0;
let monthPlanned = 0;

viewedMonthLogs?.forEach(log => {
  const day = parseInt(log.date.split('-')[2], 10);
  if (!hoursByDay[day]) hoursByDay[day] = { actual: 0, planned: 0 };
  
  if (log.is_planned) {
    hoursByDay[day].planned += log.hours;
    monthPlanned += log.hours;
  } else {
    hoursByDay[day].actual += log.hours;
    monthActual += log.hours;
  }
});

---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Personal Planner</title>
  <style>
    body { background: #09090b; color: #fafafa; font-family: system-ui, -apple-system, sans-serif; padding: 1rem; padding-bottom: 6rem; margin: 0; }
    .header-bar { display: flex; justify-content: flex-end; margin-bottom: 1rem; }
    .container { max-width: 950px; margin: 0 auto; }
    
    .month-nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .month-nav button { background: #27272a; color: white; border: none; padding: 0.6rem 1rem; border-radius: 6px; font-weight: bold; cursor: pointer; transition: 0.2s; }
    .month-nav button:hover { background: #3f3f46; }
    
    .dashboard { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 1rem; }
    .stat-card { background: #18181b; border: 1px solid #27272a; padding: 1.5rem; border-radius: 12px; text-align: center; }
    .stat-card.actual { border-top: 4px solid #2563eb; }
    .stat-card.planned { border-top: 4px solid #60a5fa; }
    .stat-label { font-size: 0.8rem; color: #a1a1aa; text-transform: uppercase; letter-spacing: 1px; }
    .stat-value { font-size: 2.5rem; font-weight: bold; margin-top: 0.5rem; }

    .calendar-header { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; font-weight: bold; font-size: 0.75rem; color: #71717a; margin-bottom: 5px; }
    .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; background: #27272a; border-radius: 8px; overflow: hidden; margin-bottom: 1rem; }
    .day-box { background: #18181b; min-height: 70px; padding: 5px; cursor: pointer; transition: 0.2s; }
    .day-number { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; font-size: 0.75rem; color: #8b8b93; font-weight: 400; }
    .day-number.today { background: #2563eb; color: #fff; font-weight: 700; }
    .day-box:hover { background: #27272a; }
    /* These classes are applied to elements created in client-side JS.
       Using :global() prevents Astro from scoping them with a data-astro-cid attribute,
       ensuring the styles apply to our dynamically generated divs. */
    :global(.hours-actual) { background: #2563eb; color: white; font-size: 0.7rem; padding: 2px; border-radius: 4px; margin-top: 2px; text-align: center; font-weight: bold; }
    :global(.hours-planned) { border: 1px dashed #60a5fa; color: #60a5fa; font-size: 0.7rem; padding: 2px; border-radius: 4px; margin-top: 2px; text-align: center; }
    
    input, textarea, button.form-btn { padding: 0.8rem; border-radius: 6px; border: 1px solid #3f3f46; background: #09090b; color: white; font-family: inherit; }
    .btn-primary { background: #2563eb; border: none; font-weight: bold; cursor: pointer; color: white; }
    .btn-primary:hover { background: #1d4ed8; }

    .log-item { border-bottom: 1px solid #27272a; padding: 1rem 0; display: flex; justify-content: space-between; align-items: flex-start; }
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(9, 9, 11, 0.8);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      backdrop-filter: blur(4px);
    }
    .modal-content {
      background: #18181b;
      padding: 2rem;
      border-radius: 12px;
      border: 1px solid #27272a;
      max-width: 400px;
      text-align: center;
    }
    .log-item-header {
      font-weight: bold;
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .log-item-notes {
      font-size: 0.85rem;
      color: #a1a1aa;
      font-style: italic;
    }
    .log-item-info {
      flex-grow: 1;
    }
    .log-item-hours {
      color: #60a5fa;
    }
    .log-badge.planned { border: 1px dashed #60a5fa; color: #60a5fa; padding: 2px 6px; border-radius: 12px; font-size: 0.7rem; }
    .action-group { display: flex; gap: 8px; }
    .btn-edit { background: transparent; border: 1px solid #3f3f46; color: #fafafa; padding: 0.4rem 0.8rem; border-radius: 4px; cursor: pointer; }
    .btn-delete { background: transparent; border: 1px solid #ef4444; color: #ef4444; padding: 0.4rem 0.8rem; border-radius: 4px; cursor: pointer; }

    .toast-container {
      position: fixed;
      bottom: 5rem;
      right: 1.5rem;
      z-index: 2000;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.75rem;
    }
    .toast {
      padding: 0.75rem 1.25rem;
      border-radius: 8px;
      color: white;
      font-weight: 500;
      box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
      animation: toast-in 0.3s ease-out forwards;
      opacity: 0;
    }
    .toast.fade-out {
      animation: toast-out 0.4s ease-in forwards;
    }
    .toast.success { background-color: #22c55e; }
    .toast.error { background-color: #ef4444; }

    @keyframes toast-in {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes toast-out {
      from {
        opacity: 1;
        transform: translateY(0);
      }
      to {
        opacity: 0;
        transform: translateY(20px);
      }
    }

    /* --- MOBILE RESPONSIVENESS --- */
    @media (max-width: 640px) {
      body {
        padding: 0.5rem; /* Reduce body padding on small screens */
      }
      .container {
        padding: 0 0.5rem; /* Add horizontal padding to the main container */
      }
      .month-nav {
        gap: 0.5rem;
      }
      .month-nav h2 {
        font-size: 1.1rem;
        text-align: center;
      }
      .month-nav button {
        padding: 0.5rem 0.75rem;
      }
      .stat-card {
        padding: 1rem;
      }
      .stat-value {
        font-size: 2rem;
      }
      .day-box {
        min-height: 60px; /* Slightly smaller day boxes */
      }
      .log-item {
        /* Transform list items into cards on mobile */
        flex-direction: column;
        gap: 1rem;
        align-items: flex-start;
        padding: 1rem;
        border-radius: 8px;
        background: #18181b;
        border-bottom: none; /* Remove the desktop line separator */
      }
      /* Add space between the new log item cards */
      #logListContainer {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .log-item-header {
        font-size: 1rem; /* Increase font size for readability */
      }
      .action-group {
        width: 100%; /* Make buttons take full width */
        display: grid;
        grid-template-columns: 1fr 1fr;
      }
      .btn-edit, .btn-delete {
        padding: 0.8rem; /* Larger touch targets */
        text-align: center;
        font-weight: bold;
      }
      .modal-content {
        width: 90%;
        padding: 1.5rem;
      }
    }

    /* FAB */
    .fab {
      position: fixed;
      bottom: 6rem;
      right: 1.5rem;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: #2563eb;
      color: white;
      border: none;
      font-size: 1.75rem;
      line-height: 1;
      cursor: pointer;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 16px rgba(37, 99, 235, 0.5);
      transition: background 0.2s;
    }
    .fab:hover { background: #1d4ed8; }

    /* Entry Modal (Bottom Sheet) */
    .entry-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(9, 9, 11, 0.75);
      z-index: 200;
      display: none;
      backdrop-filter: blur(2px);
    }
    .entry-modal-overlay.open { display: block; }

    .entry-modal {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #18181b;
      border-top: 1px solid #3f3f46;
      border-radius: 16px 16px 0 0;
      padding: 1.5rem;
      z-index: 201;
      transform: translateY(100%);
      transition: transform 0.3s ease-out;
    }
    .entry-modal.open { transform: translateY(0); }

    .entry-modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }
    .modal-close-btn {
      background: transparent;
      border: none;
      color: #71717a;
      font-size: 1.5rem;
      cursor: pointer;
      line-height: 1;
      padding: 0.25rem;
    }
    .modal-close-btn:hover { color: #fafafa; }

    .hour-stepper {
      display: flex;
      align-items: center;
      gap: 1rem;
      background: #09090b;
      border: 1px solid #3f3f46;
      border-radius: 6px;
      padding: 0.5rem 1rem;
    }
    .stepper-btn {
      background: #27272a;
      border: none;
      color: white;
      width: 36px;
      height: 36px;
      border-radius: 6px;
      font-size: 1.25rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .stepper-btn:hover { background: #3f3f46; }
    .stepper-value {
      flex: 1;
      text-align: center;
      font-size: 1.5rem;
      font-weight: bold;
    }
    .modal-toggle-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
  </style>
</head>
<body
  data-access-token={sessionAccessToken}
  data-logs={JSON.stringify(viewedMonthLogs || [])}
  data-default-date={defaultDate}
  data-current-year={currentYear}
  data-current-month={currentMonth}
>

  <div id="toast-container" class="toast-container"></div>

  <header class="header-bar">
    <SignOut />
  </header>

  <div class="container">
    <div class="month-nav">
      <button type="button" onclick={`window.__showNavProgress && window.__showNavProgress(); window.location.search='?month=${prevMonth}&year=${prevYear}'`}>&larr; Prev</button>
      <h2 style="margin: 0; display: flex; align-items: center; gap: 10px;">
        {monthName} {currentYear}
        {!isCurrentMonth && <button type="button" onclick="window.__showNavProgress && window.__showNavProgress(); window.location.search=''" style="font-size: 0.7rem; background: #2563eb; padding: 4px 8px; border-radius: 4px;">Today</button>}
      </h2>
      <button type="button" onclick={`window.__showNavProgress && window.__showNavProgress(); window.location.search='?month=${nextMonth}&year=${nextYear}'`}>Next &rarr;</button>
    </div>
    
    <div class="dashboard">
      <div class="stat-card actual">
        <div class="stat-label">Actual Hours</div>
        <div id="monthActualValue" class="stat-value">{monthActual}</div>
      </div>
      <div class="stat-card planned">
        <div class="stat-label">Planned Hours</div>
        <div id="monthPlannedValue" class="stat-value">{monthPlanned}</div>
      </div>
    </div>
    
    <div class="calendar-header">
      <div>S</div><div>M</div><div>T</div><div>W</div><div>T</div><div>F</div><div>S</div>
    </div>
    <div class="calendar-grid" id="calendarGrid">
      {Array.from({ length: firstDayIndex }).map(() => <div class="day-box" style="background: #09090b; cursor: default;"></div>)}
      {Array.from({ length: daysInMonth }).map((_, i) => {
        const day = i + 1;
        const data = hoursByDay[day];
        const isToday = isCurrentMonth && day === now.getDate();
        return (
          <div class="day-box" data-day={day} onclick={`selectDate('${currentYear}-${String(currentMonth+1).padStart(2,'0')}-${String(day).padStart(2,'0')}')`}>
            <span class={`day-number${isToday ? ' today' : ''}`}>{day}</span>
            {data?.actual > 0 && <div class="hours-actual">{data.actual}h</div>}
            {data?.planned > 0 && <div class="hours-planned">P: {data.planned}h</div>}
          </div>
        )
      })}
    </div>

    <div style="margin-top: 2rem;">
      <h3>Entries for {monthName}</h3>
      <div id="logListContainer">
        {viewedMonthLogs?.length === 0 && <p style="color: #71717a;">No entries for this month.</p>}
        {viewedMonthLogs?.map((log) => (
          <div class="log-item" data-log-id={log.id}>
            <div class="log-item-info">
              <div class="log-item-header">
                <span class="log-item-date">{new Date(log.date).toLocaleDateString('en-AU', { timeZone: 'UTC', weekday: 'short', day: 'numeric', month: 'short' })}</span>
                <span class="log-item-hours">{log.hours} hrs</span>
                {log.is_planned && <span class="log-badge planned">Planned</span>}
              </div>
              {log.notes && <div class="log-item-notes">{log.notes}</div>}
            </div>
            <div class="action-group">
              <button type="button" class="btn-edit" 
                data-id={log.id} data-date={log.date} data-hours={log.hours} 
                data-planned={String(log.is_planned)} data-notes={log.notes || ''}>Edit</button>
              <button type="button" class="btn-delete" data-id={log.id}>Delete</button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <template id="log-item-template">
    <div class="log-item">
      <div class="log-item-info">
        <div class="log-item-header">
          <span class="log-item-date"></span>
          <span class="log-item-hours"></span>
          <span class="log-badge planned">Planned</span>
        </div>
        <div class="log-item-notes"></div>
      </div>
      <div class="action-group">
        <button type="button" class="btn-edit">Edit</button>
        <button type="button" class="btn-delete">Delete</button>
      </div>
    </div>
  </template>

  <div id="deleteModal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
      <h4 style="margin-top: 0;">Confirm Deletion</h4>
      <p style="color: #a1a1aa;">Are you sure you want to delete this log entry? This action cannot be undone.</p>
      <div style="display: flex; justify-content: center; gap: 1rem; margin-top: 1.5rem;">
        <button type="button" id="cancelDeleteBtn" class="form-btn btn-cancel" style="display: inline-block; flex: 1;">Cancel</button>
        <button type="button" id="confirmDeleteBtn" class="form-btn" style="background: #ef4444; color: white; flex: 1;">Delete</button>
      </div>
    </div>
  </div>

  <button id="fab" class="fab" type="button">+</button>

  <BottomNav />

  <div id="entryModalOverlay" class="entry-modal-overlay"></div>
  <div id="entryModal" class="entry-modal">
    <div class="entry-modal-header">
      <h3 id="modalDateLabel" style="margin: 0; font-size: 1.1rem; font-weight: bold;"></h3>
      <button type="button" id="modalCloseBtn" class="modal-close-btn">&#x2715;</button>
    </div>
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <div>
        <div style="font-size: 0.8rem; color: #a1a1aa; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem;">Hours</div>
        <div class="hour-stepper">
          <button type="button" id="stepperMinus" class="stepper-btn">&#x2212;</button>
          <div id="stepperValue" class="stepper-value">0h</div>
          <button type="button" id="stepperPlus" class="stepper-btn">+</button>
        </div>
      </div>
      <div>
        <div style="font-size: 0.8rem; color: #a1a1aa; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem;">Notes</div>
        <textarea id="modalNotes" class="form-btn" placeholder="Notes..." style="width: 100%; box-sizing: border-box; min-height: 80px; resize: vertical;"></textarea>
      </div>
      <div class="modal-toggle-row">
        <input type="checkbox" id="modalPlanned" />
        <label for="modalPlanned">Mark as Planned</label>
      </div>
      <button type="button" id="modalSaveBtn" class="form-btn btn-primary">Save Log</button>
    </div>
  </div>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const accessToken = document.body.dataset.accessToken;

    const supabase = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
      {
        global: {
          headers: {
            Authorization: `Bearer ${accessToken}`
          }
        }
      }
    );

    interface PlannerLog {
      id: string;
      date: string;
      hours: number;
      notes: string | null;
      is_planned: boolean;
    }

    document.addEventListener('DOMContentLoaded', () => {
      const body = document.body;

      // --- STATE ---
      let logs: PlannerLog[] = JSON.parse(body.dataset.logs || '[]');
      const defaultDate = body.dataset.defaultDate || '';
      const currentYear = parseInt(body.dataset.currentYear!, 10);
      const currentMonth = parseInt(body.dataset.currentMonth!, 10);
      let logIdToDelete: string | null = null;
      let selectedDate: string = defaultDate;
      let editingLogId: string | null = null;
      let modalHours: number = 0;

      // --- DOM ELEMENTS ---
      const deleteModal = document.getElementById('deleteModal') as HTMLDivElement;
      const cancelDeleteBtn = document.getElementById('cancelDeleteBtn') as HTMLButtonElement;
      const confirmDeleteBtn = document.getElementById('confirmDeleteBtn') as HTMLButtonElement;
      const logListContainer = document.getElementById('logListContainer') as HTMLDivElement;
      const monthActualValue = document.getElementById('monthActualValue') as HTMLDivElement;
      const monthPlannedValue = document.getElementById('monthPlannedValue') as HTMLDivElement;
      const calendarGrid = document.getElementById('calendarGrid') as HTMLDivElement;
      const toastContainer = document.getElementById('toast-container') as HTMLDivElement;
      const fab = document.getElementById('fab') as HTMLButtonElement;
      const entryModalOverlay = document.getElementById('entryModalOverlay') as HTMLDivElement;
      const entryModal = document.getElementById('entryModal') as HTMLDivElement;
      const modalDateLabel = document.getElementById('modalDateLabel') as HTMLElement;
      const modalCloseBtn = document.getElementById('modalCloseBtn') as HTMLButtonElement;
      const stepperMinus = document.getElementById('stepperMinus') as HTMLButtonElement;
      const stepperPlus = document.getElementById('stepperPlus') as HTMLButtonElement;
      const stepperValue = document.getElementById('stepperValue') as HTMLDivElement;
      const modalNotes = document.getElementById('modalNotes') as HTMLTextAreaElement;
      const modalPlanned = document.getElementById('modalPlanned') as HTMLInputElement;
      const modalSaveBtn = document.getElementById('modalSaveBtn') as HTMLButtonElement;

      if (!logListContainer || !deleteModal) {
        console.error("Essential planner elements could not be found in the DOM. The script will not run.");
        return;
      }

      // --- TOAST ---
      function showToast(message: string, type: 'success' | 'error' = 'success') {
        if (!toastContainer) return;
        const toast = document.createElement('div');
        toast.classList.add('toast', type);
        toast.textContent = message;
        toastContainer.appendChild(toast);
        const FADE_DURATION_MS = 400;
        const VISIBLE_DURATION_MS = 2000;
        setTimeout(() => {
          toast.classList.add('fade-out');
          setTimeout(() => toast.remove(), FADE_DURATION_MS);
        }, VISIBLE_DURATION_MS);
      }

      // --- LOG LIST RENDERING ---
      function createLogElement(log: PlannerLog) {
        const template = document.getElementById('log-item-template') as HTMLTemplateElement;
        if (!template) {
          console.error('The log item template was not found.');
          return document.createElement('div');
        }
        const clone = template.content.cloneNode(true) as DocumentFragment;
        const logItem = clone.querySelector('.log-item') as HTMLDivElement;
        logItem.dataset.logId = log.id;
        (clone.querySelector('.log-item-date') as HTMLElement).textContent = new Date(log.date).toLocaleDateString('en-AU', {
          timeZone: 'UTC', weekday: 'short', day: 'numeric', month: 'short'
        });
        (clone.querySelector('.log-item-hours') as HTMLElement).textContent = `${log.hours || 0} hrs`;
        if (!log.is_planned) clone.querySelector('.log-badge.planned')?.remove();
        if (log.notes) {
          (clone.querySelector('.log-item-notes') as HTMLElement).textContent = log.notes;
        } else {
          clone.querySelector('.log-item-notes')?.remove();
        }
        const editBtn = clone.querySelector('.btn-edit') as HTMLButtonElement;
        Object.assign(editBtn.dataset, {
          id: log.id, date: log.date, hours: String(log.hours),
          planned: String(log.is_planned), notes: log.notes || '',
        });
        const deleteBtn = clone.querySelector('.btn-delete') as HTMLButtonElement;
        deleteBtn.dataset.id = log.id;
        return logItem;
      }

      function renderLogList() {
        logListContainer.innerHTML = '';
        if (logs.length === 0) {
          logListContainer.innerHTML = `<p style="color: #71717a;">No entries for this month.</p>`;
          return;
        }
        const sortedLogs = [...logs].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
        sortedLogs.forEach(log => logListContainer.appendChild(createLogElement(log)));
      }

      function updateDashboardAndCalendar() {
        const hoursByDay: Record<number, { actual: number, planned: number }> = {};
        let monthActual = 0;
        let monthPlanned = 0;
        logs.forEach(log => {
          const day = parseInt(log.date.split('-')[2], 10);
          if (!hoursByDay[day]) hoursByDay[day] = { actual: 0, planned: 0 };
          const hours = log.hours || 0;
          if (log.is_planned) { hoursByDay[day].planned += hours; monthPlanned += hours; }
          else { hoursByDay[day].actual += hours; monthActual += hours; }
        });
        monthActualValue.textContent = String(monthActual);
        monthPlannedValue.textContent = String(monthPlanned);
        calendarGrid.querySelectorAll('.day-box[data-day]').forEach(dayBox => {
          const day = parseInt((dayBox as HTMLElement).dataset.day!, 10);
          const data = hoursByDay[day] || { actual: 0, planned: 0 };
          const dayNumberSpan = dayBox.querySelector('.day-number') as HTMLSpanElement;
          if (!dayNumberSpan) return;
          dayBox.querySelectorAll('.hours-actual, .hours-planned').forEach(el => el.remove());
          let lastInsertedElement: HTMLElement = dayNumberSpan;
          if (data.actual > 0) {
            const actualEl = document.createElement('div');
            actualEl.className = 'hours-actual';
            actualEl.textContent = `${data.actual}h`;
            lastInsertedElement.after(actualEl);
            lastInsertedElement = actualEl;
          }
          if (data.planned > 0) {
            const plannedEl = document.createElement('div');
            plannedEl.className = 'hours-planned';
            plannedEl.textContent = `P: ${data.planned}h`;
            lastInsertedElement.after(plannedEl);
          }
        });
      }

      // --- FAB & ENTRY MODAL ---
      function updateStepperDisplay() {
        stepperValue.textContent = `${modalHours}h`;
      }

      function openEntryModal(dateStr: string) {
        selectedDate = dateStr;
        editingLogId = null;
        modalHours = 0;
        modalNotes.value = '';
        modalPlanned.checked = false;

        const existing = logs.find(log => log.date === dateStr);
        if (existing) {
          editingLogId = existing.id;
          modalHours = existing.hours || 0;
          modalNotes.value = existing.notes || '';
          modalPlanned.checked = existing.is_planned;
        }

        modalDateLabel.textContent = new Date(dateStr).toLocaleDateString('en-AU', {
          timeZone: 'UTC', weekday: 'short', day: 'numeric', month: 'long', year: 'numeric'
        });
        updateStepperDisplay();
        entryModalOverlay.classList.add('open');
        entryModal.classList.add('open');
      }

      function closeEntryModal() {
        entryModalOverlay.classList.remove('open');
        entryModal.classList.remove('open');
        editingLogId = null;
        modalHours = 0;
      }

      // Expose selectDate globally for inline onclick handlers on day boxes
      (window as any).selectDate = function(dateStr: string) {
        selectedDate = dateStr;
      };

      fab.addEventListener('click', () => openEntryModal(selectedDate));

      stepperMinus.addEventListener('click', () => {
        if (modalHours > 0) {
          modalHours = Math.round((modalHours - 0.5) * 10) / 10;
          updateStepperDisplay();
        }
      });
      stepperPlus.addEventListener('click', () => {
        modalHours = Math.round((modalHours + 0.5) * 10) / 10;
        updateStepperDisplay();
      });

      entryModalOverlay.addEventListener('click', closeEntryModal);
      modalCloseBtn.addEventListener('click', closeEntryModal);

      modalSaveBtn.addEventListener('click', async () => {
        const currentEditingLogId = editingLogId;
        const payload = {
          date: selectedDate,
          hours: modalHours,
          notes: modalNotes.value,
          is_planned: modalPlanned.checked,
        };

        let result;
        if (currentEditingLogId) {
          result = await supabase.from('planner_logs').update(payload).eq('id', currentEditingLogId).select().single();
        } else {
          result = await supabase.from('planner_logs').insert(payload).select().single();
        }

        const { data: newOrUpdatedLog, error } = result;
        if (error) {
          showToast(`Error: ${error.message}`, 'error');
        } else if (newOrUpdatedLog) {
          const isDifferentMonth = !newOrUpdatedLog.date.startsWith(`${currentYear}-${String(currentMonth + 1).padStart(2, '0')}`);
          if (isDifferentMonth) {
            location.reload();
          } else {
            if (currentEditingLogId) {
              const index = logs.findIndex(log => log.id === currentEditingLogId);
              if (index !== -1) logs[index] = newOrUpdatedLog;
            } else {
              logs.push(newOrUpdatedLog);
            }
            showToast(currentEditingLogId ? 'Log updated successfully.' : 'Log saved successfully.');
            renderLogList();
            updateDashboardAndCalendar();
            closeEntryModal();
          }
        }
      });

      // --- EVENT DELEGATION for Edit/Delete ---
      logListContainer.addEventListener('click', e => {
        const target = e.target as HTMLElement;
        const editBtn = target.closest('.btn-edit') as HTMLButtonElement;
        const deleteBtn = target.closest('.btn-delete') as HTMLButtonElement;
        if (editBtn) openEntryModal(editBtn.dataset.date || '');
        if (deleteBtn) {
          logIdToDelete = deleteBtn.dataset.id || null;
          if (logIdToDelete) deleteModal.style.display = 'flex';
        }
      });

      // --- DELETE MODAL ---
      function closeDeleteModal() {
        deleteModal.style.display = 'none';
        logIdToDelete = null;
      }
      cancelDeleteBtn.addEventListener('click', closeDeleteModal);
      deleteModal.addEventListener('click', (e) => { if (e.target === deleteModal) closeDeleteModal(); });
      confirmDeleteBtn.addEventListener('click', async () => {
        if (!logIdToDelete) return;
        const { error } = await supabase.from('planner_logs').delete().eq('id', logIdToDelete);
        if (error) {
          showToast("Error: " + error.message, 'error');
        } else {
          showToast('Log entry deleted successfully.');
          logs = logs.filter(log => log.id !== logIdToDelete);
          renderLogList();
          updateDashboardAndCalendar();
        }
        closeDeleteModal();
      });
    });
  </script>
</body>
</html>