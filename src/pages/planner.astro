---
import SignOut from '../components/SignOut.astro';
import BottomNav from '../components/BottomNav.astro';

// Static page served from Netlify's CDN. Auth, the month grid and the data
// all load in the browser (see the script below and src/lib/browserSession.ts),
// which skips a slow round trip through the US-based Netlify function.
export const prerender = true;
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Personal Planner</title>
  <style>
    body { background: #09090b; color: #fafafa; font-family: system-ui, -apple-system, sans-serif; padding: 1rem; padding-bottom: 6rem; margin: 0; }
    .header-bar { display: flex; justify-content: flex-end; margin-bottom: 1rem; }
    .container { max-width: 950px; margin: 0 auto; }
    
    .month-nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .month-nav button { background: #27272a; color: white; border: none; padding: 0.6rem 1rem; border-radius: 6px; font-weight: bold; cursor: pointer; transition: 0.2s; }
    .month-nav button:hover { background: #3f3f46; }
    
    .dashboard { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 1rem; }
    .stat-card { background: #18181b; border: 1px solid #27272a; padding: 1.5rem; border-radius: 12px; text-align: center; }
    .stat-card.actual { border-top: 4px solid #2563eb; }
    .stat-card.planned { border-top: 4px solid #60a5fa; }
    .stat-label { font-size: 0.8rem; color: #a1a1aa; text-transform: uppercase; letter-spacing: 1px; }
    .stat-value { font-size: 2.5rem; font-weight: bold; margin-top: 0.5rem; }

    .calendar-header { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; font-weight: bold; font-size: 0.75rem; color: #71717a; margin-bottom: 5px; }
    .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; background: #27272a; border-radius: 8px; overflow: hidden; margin-bottom: 1rem; }
    /* Day boxes are built by client JS (renderCalendarGrid), hence :global() */
    :global(.day-box) { background: #18181b; min-height: 70px; padding: 5px; cursor: pointer; transition: 0.2s; }
    :global(.day-number) { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; font-size: 0.75rem; color: #8b8b93; font-weight: 400; }
    :global(.day-number.today) { background: #2563eb; color: #fff; font-weight: 700; }
    :global(.day-box:hover) { background: #27272a; }
    /* These classes are applied to elements created in client-side JS.
       Using :global() prevents Astro from scoping them with a data-astro-cid attribute,
       ensuring the styles apply to our dynamically generated divs. */
    :global(.hours-actual) { background: #2563eb; color: white; font-size: 0.7rem; padding: 2px; border-radius: 4px; margin-top: 2px; text-align: center; font-weight: bold; }
    :global(.hours-planned) { border: 1px dashed #60a5fa; color: #60a5fa; font-size: 0.7rem; padding: 2px; border-radius: 4px; margin-top: 2px; text-align: center; }
    :global(.hours-credit) { background: #f59e0b; color: #18181b; font-size: 0.7rem; padding: 2px; border-radius: 4px; margin-top: 2px; text-align: center; font-weight: bold; }
    :global(.hours-credit-planned) { border: 1px dashed #fbbf24; color: #fbbf24; font-size: 0.7rem; padding: 2px; border-radius: 4px; margin-top: 2px; text-align: center; }
    .stat-sub { font-size: 0.75rem; color: #a1a1aa; margin-top: 0.35rem; }

    /* Entries list — week groups and cards are built by client JS, hence :global() */
    #logListContainer { display: flex; flex-direction: column; gap: 1.25rem; }
    :global(.week-group) { display: flex; flex-direction: column; gap: 0.5rem; }
    :global(.week-header) {
      display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; flex-wrap: wrap;
      font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: #a1a1aa; padding: 0 0.25rem;
    }
    :global(.week-header-total) { text-transform: none; letter-spacing: 0; color: #71717a; }
    :global(.entry-card) {
      display: flex; align-items: center; gap: 0.9rem; width: 100%;
      background: #18181b; border: 1px solid #27272a; border-radius: 12px;
      padding: 0.75rem 0.9rem; color: inherit; font-family: inherit; text-align: left;
      cursor: pointer; touch-action: manipulation;
    }
    :global(.entry-card:hover) { background: #1f1f23; }
    :global(.entry-card:active) { background: #27272a; }
    :global(.entry-date) { display: flex; flex-direction: column; align-items: center; min-width: 2.5rem; flex-shrink: 0; }
    :global(.entry-date-num) { font-size: 1.35rem; font-weight: 700; line-height: 1.1; }
    :global(.entry-date-dow) { font-size: 0.7rem; color: #a1a1aa; text-transform: uppercase; letter-spacing: 0.5px; }
    :global(.entry-body) { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    :global(.entry-title) { font-size: 0.9rem; font-weight: 600; }
    :global(.entry-title-muted) { color: #71717a; font-weight: 400; }
    :global(.entry-notes) {
      font-size: 0.8rem; color: #a1a1aa;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    :global(.entry-amount) { flex-shrink: 0; font-size: 0.95rem; font-weight: 700; padding: 4px 10px; border-radius: 999px; }
    :global(.entry-amount.hours) { background: #2563eb; color: white; }
    :global(.entry-amount.hours.planned) { background: none; border: 1px dashed #60a5fa; color: #60a5fa; }
    :global(.entry-amount.credit) { background: #f59e0b; color: #18181b; }
    :global(.entry-amount.credit.planned) { background: none; border: 1px dashed #fbbf24; color: #fbbf24; }
    :global(.entries-empty) { color: #71717a; margin: 0; }

    /* Hours | Credit toggle in the day sheet; aria-pressed is toggled by client JS */
    .kind-toggle { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; background: #27272a; border-radius: 12px; padding: 4px; }
    .kind-option {
      height: 40px; border: none; border-radius: 9px; background: none; color: #a1a1aa;
      font-family: inherit; font-size: 0.95rem; font-weight: 600; cursor: pointer; touch-action: manipulation;
    }
    :global(.kind-option[aria-pressed="true"]) { background: #3f3f46; color: #fafafa; }
    
    input, textarea, button.form-btn { padding: 0.8rem; border-radius: 6px; border: 1px solid #3f3f46; background: #09090b; color: white; font-family: inherit; }
    .btn-primary { background: #2563eb; border: none; font-weight: bold; cursor: pointer; color: white; }
    .btn-primary:hover { background: #1d4ed8; }

    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(9, 9, 11, 0.8);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      backdrop-filter: blur(4px);
    }
    .modal-content {
      background: #18181b;
      padding: 2rem;
      border-radius: 12px;
      border: 1px solid #27272a;
      max-width: 400px;
      text-align: center;
    }

    .toast-container {
      position: fixed;
      bottom: 5rem;
      right: 1.5rem;
      z-index: 2000;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.75rem;
    }
    .toast {
      padding: 0.75rem 1.25rem;
      border-radius: 8px;
      color: white;
      font-weight: 500;
      box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
      animation: toast-in 0.3s ease-out forwards;
      opacity: 0;
    }
    .toast.fade-out {
      animation: toast-out 0.4s ease-in forwards;
    }
    .toast.success { background-color: #22c55e; }
    .toast.error { background-color: #ef4444; }

    @keyframes toast-in {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes toast-out {
      from {
        opacity: 1;
        transform: translateY(0);
      }
      to {
        opacity: 0;
        transform: translateY(20px);
      }
    }

    /* --- MOBILE RESPONSIVENESS --- */
    @media (max-width: 640px) {
      body {
        padding: 0.5rem; /* Reduce body padding on small screens */
      }
      .container {
        padding: 0 0.5rem; /* Add horizontal padding to the main container */
      }
      .month-nav {
        gap: 0.5rem;
      }
      .month-nav h2 {
        font-size: 1.1rem;
        text-align: center;
      }
      .month-nav button {
        padding: 0.5rem 0.75rem;
      }
      .stat-card {
        padding: 1rem;
      }
      .stat-value {
        font-size: 2rem;
      }
      :global(.day-box) {
        min-height: 60px; /* Slightly smaller day boxes */
      }
      .modal-content {
        width: 90%;
        padding: 1.5rem;
      }
    }

    /* FAB */
    .fab {
      position: fixed;
      bottom: 6rem;
      right: 1.5rem;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: #2563eb;
      color: white;
      border: none;
      font-size: 1.75rem;
      line-height: 1;
      cursor: pointer;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 16px rgba(37, 99, 235, 0.5);
      transition: background 0.2s;
    }
    .fab:hover { background: #1d4ed8; }

    /* Entry Modal (Bottom Sheet) */
    .entry-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(9, 9, 11, 0.75);
      z-index: 200;
      display: none;
      backdrop-filter: blur(2px);
    }
    .entry-modal-overlay.open { display: block; }

    .entry-modal {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #141416;
      border-radius: 28px 28px 0 0;
      max-height: 85vh;
      overflow-y: auto;
      z-index: 201;
      transform: translateY(100%);
      transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
      box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.6);
    }
    .entry-modal.open { transform: translateY(0); }

    /* Drag handle zone for swipe-to-close — no browser panning/scrolling here */
    .entry-modal-grabber,
    .entry-modal-header {
      touch-action: none;
      cursor: grab;
    }

    .entry-modal-grabber {
      display: flex;
      justify-content: center;
      padding-top: 10px;
    }
    .entry-modal-grabber div {
      width: 38px;
      height: 5px;
      border-radius: 5px;
      background: rgba(255, 255, 255, 0.2);
    }

    .entry-modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 1.5rem 4px;
    }
    .entry-modal-body {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 14px 1.5rem 28px;
    }
    .modal-close-btn {
      background: #27272a;
      border: none;
      width: 32px;
      height: 32px;
      border-radius: 32px;
      color: #a1a1aa;
      font-size: 1.1rem;
      cursor: pointer;
      line-height: 1;
      flex-shrink: 0;
    }
    .modal-close-btn:hover { color: #fafafa; }

    .hour-stepper {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      background: #27272a;
      border-radius: 14px;
      padding: 0.5rem 0.75rem;
    }
    .stepper-btn {
      background: #3f3f46;
      border: none;
      color: white;
      width: 40px;
      height: 40px;
      border-radius: 10px;
      font-size: 1.25rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      touch-action: manipulation; /* stop rapid taps triggering iOS double-tap zoom */
    }
    .stepper-btn:hover { background: #52525b; }

    .hour-chips {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 8px;
      margin-bottom: 10px;
    }
    .hour-chip {
      height: 48px;
      border-radius: 12px;
      border: 1px solid #3f3f46;
      background: #1f1f23;
      color: #e4e4e7;
      font-family: inherit;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      touch-action: manipulation;
    }
    /* .active is toggled by client JS */
    :global(.hour-chip.active) { background: #2563eb; border-color: #2563eb; color: white; }
    .stepper-value {
      flex: 1;
      text-align: center;
      font-size: 1.6rem;
      font-weight: bold;
    }
    .modal-toggle-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      cursor: pointer;
    }
    .modal-toggle-row input[type="checkbox"] {
      width: 22px;
      height: 22px;
      accent-color: #2563eb;
    }
    .btn-delete-entry {
      width: 100%;
      background: none;
      color: #ef4444;
      border: none;
      padding: 15px;
      margin-top: 4px;
      font-family: inherit;
      font-size: 1rem;
      font-weight: 500;
      cursor: pointer;
    }

    /* Plan-year entry strip */
    .plan-year-strip {
      width: 100%;
      background: none;
      border: 1.5px dashed #2563eb;
      border-radius: 14px;
      padding: 13px;
      margin-bottom: 1rem;
      color: #2563eb;
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .plan-year-strip:hover { background: rgba(37, 99, 235, 0.08); }

    /* Year-plan sheet */
    .year-plan-sheet {
      display: flex;
      flex-direction: column;
      overflow-y: hidden;
    }
    .year-plan-body {
      flex: 1;
      overflow-y: auto;
      padding: 4px 1.5rem 12px;
    }
    .year-plan-hint {
      font-size: 0.8rem;
      color: #71717a;
      margin: 4px 0 12px;
    }
    .year-plan-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    /* .mini-month* / .mini-day are injected via innerHTML in the client script (see YEAR PLAN
       logic below), so Astro never stamps them with a data-astro-cid scoping attribute — these
       must stay :global() or the rules silently never match, same as .hours-actual/.hours-planned. */
    :global(.mini-month) {
      background: #1a1a1c;
      border-radius: 14px;
      padding: 10px;
    }
    :global(.mini-month-label) {
      font-size: 0.72rem;
      font-weight: 700;
      color: #8e8e93;
      margin-bottom: 6px;
      text-align: center;
    }
    :global(.mini-month-grid) {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 2px;
    }
    :global(.mini-day) {
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 5px;
      cursor: pointer;
      font-size: 0.6rem;
      font-weight: 600;
      color: #636366;
    }
    :global(.mini-day.has-existing) { background: rgba(37, 99, 235, 0.18); color: #2563eb; }
    :global(.mini-day.selected) { background: #2563eb; color: #fff; }

    .year-plan-footer {
      padding: 12px 1.5rem 26px;
      border-top: 1px solid #27272a;
      background: #141416;
      flex-shrink: 0;
    }
    .year-plan-footer-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }
    .year-plan-footer-row span {
      font-size: 0.85rem;
      color: #a1a1aa;
      font-weight: 600;
    }
    .year-plan-stepper { background: #27272a; border-radius: 12px; padding: 4px 6px; gap: 10px; }
    .stepper-btn.small { width: 30px; height: 30px; border-radius: 8px; font-size: 1rem; }
    .stepper-value.small { font-size: 0.95rem; min-width: 40px; flex: none; }
    #yearPlanSubmitBtn:disabled { background: #27272a; color: #71717a; cursor: default; }
  </style>
</head>
<body>

  <div id="toast-container" class="toast-container"></div>

  <header class="header-bar">
    <SignOut />
  </header>

  <div class="container">
    <div class="month-nav">
      <button type="button" id="prevMonthBtn">&larr; Prev</button>
      <h2 style="margin: 0; display: flex; align-items: center; gap: 10px;">
        <span id="monthLabel">&nbsp;</span>
        <button type="button" id="todayBtn" hidden style="font-size: 0.7rem; background: #2563eb; padding: 4px 8px; border-radius: 4px;">Today</button>
      </h2>
      <button type="button" id="nextMonthBtn">Next &rarr;</button>
    </div>
    
    <div class="dashboard">
      <div class="stat-card actual">
        <div class="stat-label">Total Hours</div>
        <div id="monthTotalValue" class="stat-value">–</div>
        <div id="monthTotalSub" class="stat-sub">&nbsp;</div>
      </div>
      <div class="stat-card planned">
        <div class="stat-label">Planned</div>
        <div id="monthPlannedValue" class="stat-value">–</div>
        <div id="monthPlannedSub" class="stat-sub">&nbsp;</div>
      </div>
    </div>

    <button type="button" id="planYearBtn" class="plan-year-strip">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 8h16M4 8a2 2 0 012-2h12a2 2 0 012 2M4 8v10a2 2 0 002 2h12a2 2 0 002-2V8M8 4v4M16 4v4M12 12v6M9 15h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      Plan hours for the year
    </button>

    <div class="calendar-header">
      <div>S</div><div>M</div><div>T</div><div>W</div><div>T</div><div>F</div><div>S</div>
    </div>
    <!-- Day boxes are built client-side by renderCalendarGrid() -->
    <div class="calendar-grid" id="calendarGrid"></div>

    <div style="margin-top: 2rem;">
      <h3>Entries for <span id="entriesMonth"></span></h3>
      <!-- Week-grouped entry cards are rendered client-side by renderLogList() -->
      <div id="logListContainer"></div>
    </div>
  </div>

  <div id="deleteModal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
      <h4 style="margin-top: 0;">Confirm Deletion</h4>
      <p style="color: #a1a1aa;">Are you sure you want to delete this log entry? This action cannot be undone.</p>
      <div style="display: flex; justify-content: center; gap: 1rem; margin-top: 1.5rem;">
        <button type="button" id="cancelDeleteBtn" class="form-btn btn-cancel" style="display: inline-block; flex: 1;">Cancel</button>
        <button type="button" id="confirmDeleteBtn" class="form-btn" style="background: #ef4444; color: white; flex: 1;">Delete</button>
      </div>
    </div>
  </div>

  <button id="fab" class="fab" type="button">+</button>

  <BottomNav />

  <div id="entryModalOverlay" class="entry-modal-overlay"></div>
  <div id="entryModal" class="entry-modal">
    <div class="entry-modal-grabber"><div></div></div>
    <div class="entry-modal-header">
      <h3 id="modalDateLabel" style="margin: 0; font-size: 1.1rem; font-weight: bold;"></h3>
      <button type="button" id="modalCloseBtn" class="modal-close-btn">&#x2715;</button>
    </div>
    <div class="entry-modal-body">
      <div id="kindToggle" class="kind-toggle" role="group" aria-label="Entry type">
        <button type="button" class="kind-option" data-kind="hours" aria-pressed="true">Hours</button>
        <button type="button" class="kind-option" data-kind="credit" aria-pressed="false">Credit</button>
      </div>
      <div>
        <div style="font-size: 0.8rem; color: #a1a1aa; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem;">Amount</div>
        <div id="hourChips" class="hour-chips">
          {[1, 2, 3, 4, 5, 6, 7, 8].map(h => (
            <button type="button" class="hour-chip" data-hours={h}>{h}h</button>
          ))}
        </div>
        <div class="hour-stepper">
          <button type="button" id="stepperMinus" class="stepper-btn">&#x2212;</button>
          <div id="stepperValue" class="stepper-value">0h</div>
          <button type="button" id="stepperPlus" class="stepper-btn">+</button>
        </div>
      </div>
      <div>
        <div style="font-size: 0.8rem; color: #a1a1aa; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem;">Notes</div>
        <textarea id="modalNotes" class="form-btn" placeholder="Notes..." style="width: 100%; box-sizing: border-box; min-height: 80px; resize: vertical; font-size: 16px;"></textarea>
      </div>
      <label class="modal-toggle-row">
        <input type="checkbox" id="modalPlanned" />
        <span>Mark as Planned</span>
      </label>
      <button type="button" id="modalSaveBtn" class="form-btn btn-primary">Save Log</button>
      <button type="button" id="modalDeleteBtn" class="btn-delete-entry" style="display: none;">Delete entry</button>
    </div>
  </div>

  <div id="yearPlanOverlay" class="entry-modal-overlay"></div>
  <div id="yearPlanSheet" class="entry-modal year-plan-sheet">
    <div class="entry-modal-grabber"><div></div></div>
    <div class="entry-modal-header">
      <h3 id="yearPlanTitle" style="margin: 0; font-size: 1.1rem; font-weight: bold;">Plan hours</h3>
      <button type="button" id="yearPlanCloseBtn" class="modal-close-btn">&#x2715;</button>
    </div>
    <div class="year-plan-body">
      <p class="year-plan-hint">Tap any days across the year to add them to your plan.</p>
      <div id="yearPlanGrid" class="year-plan-grid"></div>
    </div>
    <div class="year-plan-footer">
      <div class="year-plan-footer-row">
        <span id="yearPlanCount">0 days selected</span>
        <div class="hour-stepper year-plan-stepper">
          <button type="button" id="yearPlanHoursMinus" class="stepper-btn small">&#x2212;</button>
          <div id="yearPlanHoursValue" class="stepper-value small">4h</div>
          <button type="button" id="yearPlanHoursPlus" class="stepper-btn small">+</button>
        </div>
      </div>
      <button type="button" id="yearPlanSubmitBtn" class="form-btn btn-primary" disabled>Plan days</button>
    </div>
  </div>

  <script>
    import type { SupabaseClient } from '@supabase/supabase-js';
    import { getBrowserSession } from '../lib/browserSession';

    // Set once the session loads (see the end of the DOMContentLoaded handler).
    let supabase: SupabaseClient;

    interface PlannerLog {
      id: string;
      date: string;
      hours: number;
      notes: string | null;
      is_planned: boolean;
      kind: EntryKind;
    }

    type EntryKind = 'hours' | 'credit';
    type DayTotals = { actual: number, planned: number, credit: number, creditPlanned: number };

    function totalsKey(log: PlannerLog): keyof DayTotals {
      if (log.kind === 'credit') return log.is_planned ? 'creditPlanned' : 'credit';
      return log.is_planned ? 'planned' : 'actual';
    }

    document.addEventListener('DOMContentLoaded', async () => {
      // --- MONTH FROM URL (?month=0-11&year=YYYY), defaulting to today in the user's timezone ---
      const now = new Date();
      const params = new URLSearchParams(location.search);
      const urlMonth = parseInt(params.get('month') ?? '', 10);
      const urlYear = parseInt(params.get('year') ?? '', 10);
      const currentYear = Number.isFinite(urlYear) ? urlYear : now.getFullYear();
      const currentMonth = urlMonth >= 0 && urlMonth <= 11 ? urlMonth : now.getMonth();
      const isCurrentMonth = currentYear === now.getFullYear() && currentMonth === now.getMonth();
      const pad = (n: number) => String(n).padStart(2, '0');
      const monthPrefix = `${currentYear}-${pad(currentMonth + 1)}`;
      const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
      const defaultDate = `${monthPrefix}-${pad(isCurrentMonth ? now.getDate() : 1)}`;

      // --- STATE ---
      let logs: PlannerLog[] = [];
      let logIdToDelete: string | null = null;
      let selectedDate: string = defaultDate;
      let editingLogId: string | null = null;
      let modalHours: number = 0;
      let modalKind: EntryKind = 'hours';
      let openedLog: PlannerLog | null = null; // the specific entry a card tap opened, if any
      let yearPlanSelected = new Set<string>();
      let yearPlanExisting = new Set<string>();
      let yearPlanHours: number = 4;
      let yearPlanLoaded = false;

      // --- DOM ELEMENTS ---
      const deleteModal = document.getElementById('deleteModal') as HTMLDivElement;
      const cancelDeleteBtn = document.getElementById('cancelDeleteBtn') as HTMLButtonElement;
      const confirmDeleteBtn = document.getElementById('confirmDeleteBtn') as HTMLButtonElement;
      const logListContainer = document.getElementById('logListContainer') as HTMLDivElement;
      const monthTotalValue = document.getElementById('monthTotalValue') as HTMLDivElement;
      const monthTotalSub = document.getElementById('monthTotalSub') as HTMLDivElement;
      const monthPlannedValue = document.getElementById('monthPlannedValue') as HTMLDivElement;
      const monthPlannedSub = document.getElementById('monthPlannedSub') as HTMLDivElement;
      const kindToggle = document.getElementById('kindToggle') as HTMLDivElement;
      const calendarGrid = document.getElementById('calendarGrid') as HTMLDivElement;
      const toastContainer = document.getElementById('toast-container') as HTMLDivElement;
      const fab = document.getElementById('fab') as HTMLButtonElement;
      const entryModalOverlay = document.getElementById('entryModalOverlay') as HTMLDivElement;
      const entryModal = document.getElementById('entryModal') as HTMLDivElement;
      const modalDateLabel = document.getElementById('modalDateLabel') as HTMLElement;
      const modalCloseBtn = document.getElementById('modalCloseBtn') as HTMLButtonElement;
      const stepperMinus = document.getElementById('stepperMinus') as HTMLButtonElement;
      const stepperPlus = document.getElementById('stepperPlus') as HTMLButtonElement;
      const stepperValue = document.getElementById('stepperValue') as HTMLDivElement;
      const hourChips = document.getElementById('hourChips') as HTMLDivElement;
      const modalNotes = document.getElementById('modalNotes') as HTMLTextAreaElement;
      const modalPlanned = document.getElementById('modalPlanned') as HTMLInputElement;
      const modalSaveBtn = document.getElementById('modalSaveBtn') as HTMLButtonElement;
      const modalDeleteBtn = document.getElementById('modalDeleteBtn') as HTMLButtonElement;
      const planYearBtn = document.getElementById('planYearBtn') as HTMLButtonElement;
      const yearPlanOverlay = document.getElementById('yearPlanOverlay') as HTMLDivElement;
      const yearPlanSheet = document.getElementById('yearPlanSheet') as HTMLDivElement;
      const yearPlanCloseBtn = document.getElementById('yearPlanCloseBtn') as HTMLButtonElement;
      const yearPlanGrid = document.getElementById('yearPlanGrid') as HTMLDivElement;
      const yearPlanCount = document.getElementById('yearPlanCount') as HTMLSpanElement;
      const yearPlanHoursMinus = document.getElementById('yearPlanHoursMinus') as HTMLButtonElement;
      const yearPlanHoursPlus = document.getElementById('yearPlanHoursPlus') as HTMLButtonElement;
      const yearPlanHoursValue = document.getElementById('yearPlanHoursValue') as HTMLDivElement;
      const yearPlanSubmitBtn = document.getElementById('yearPlanSubmitBtn') as HTMLButtonElement;

      if (!logListContainer || !deleteModal) {
        console.error("Essential planner elements could not be found in the DOM. The script will not run.");
        return;
      }

      // --- TOAST ---
      function showToast(message: string, type: 'success' | 'error' = 'success') {
        if (!toastContainer) return;
        const toast = document.createElement('div');
        toast.classList.add('toast', type);
        toast.textContent = message;
        toastContainer.appendChild(toast);
        const FADE_DURATION_MS = 400;
        const VISIBLE_DURATION_MS = 2000;
        setTimeout(() => {
          toast.classList.add('fade-out');
          setTimeout(() => toast.remove(), FADE_DURATION_MS);
        }, VISIBLE_DURATION_MS);
      }

      // --- LOG LIST RENDERING ---
      function el(tag: string, className: string, text?: string) {
        const node = document.createElement(tag);
        node.className = className;
        if (text !== undefined) node.textContent = text;
        return node;
      }

      // Dates are 'YYYY-MM-DD'; parse as UTC so weekday/week maths never shifts by timezone.
      function utcDate(iso: string) {
        return new Date(`${iso}T00:00:00Z`);
      }

      function createEntryCard(log: PlannerLog) {
        const d = utcDate(log.date);
        const card = el('button', 'entry-card') as HTMLButtonElement;
        card.type = 'button';
        card.dataset.id = log.id;

        const date = el('div', 'entry-date');
        date.append(
          el('span', 'entry-date-num', String(d.getUTCDate())),
          el('span', 'entry-date-dow', d.toLocaleDateString('en-AU', { timeZone: 'UTC', weekday: 'short' })),
        );

        const body = el('div', 'entry-body');
        const title = el('div', 'entry-title', log.kind === 'credit' ? 'Credit' : 'Ministry');
        if (log.is_planned) title.append(el('span', 'entry-title-muted', ' · Planned'));
        body.append(title);
        if (log.notes) body.append(el('div', 'entry-notes', log.notes));

        const amount = el('span', `entry-amount ${log.kind}${log.is_planned ? ' planned' : ''}`, `${log.hours || 0}h`);

        card.append(date, body, amount);
        return card;
      }

      function weekSummary(weekLogs: PlannerLog[]) {
        const t: DayTotals = { actual: 0, planned: 0, credit: 0, creditPlanned: 0 };
        weekLogs.forEach(log => { t[totalsKey(log)] += log.hours || 0; });
        const parts: string[] = [];
        if (t.actual) parts.push(`${t.actual}h logged`);
        if (t.credit) parts.push(`${t.credit}h credit`);
        if (t.planned + t.creditPlanned) parts.push(`${t.planned + t.creditPlanned}h planned`);
        return parts.join(' · ');
      }

      // Entries grouped by Sunday-start week (matching the calendar), newest first.
      function renderLogList() {
        logListContainer.innerHTML = '';
        if (logs.length === 0) {
          logListContainer.append(el('p', 'entries-empty', 'No entries for this month.'));
          return;
        }
        const sorted = [...logs].sort((a, b) => b.date.localeCompare(a.date));
        const weeks = new Map<string, PlannerLog[]>();
        sorted.forEach(log => {
          const d = utcDate(log.date);
          d.setUTCDate(d.getUTCDate() - d.getUTCDay());
          const key = d.toISOString().slice(0, 10);
          if (!weeks.has(key)) weeks.set(key, []);
          weeks.get(key)!.push(log);
        });
        weeks.forEach((weekLogs, weekStart) => {
          const group = el('section', 'week-group');
          const header = el('div', 'week-header');
          header.append(
            el('span', '', `Week of ${utcDate(weekStart).toLocaleDateString('en-AU', { timeZone: 'UTC', day: 'numeric', month: 'short' })}`),
            el('span', 'week-header-total', weekSummary(weekLogs)),
          );
          group.append(header, ...weekLogs.map(createEntryCard));
          logListContainer.append(group);
        });
      }

      const PILLS: [keyof DayTotals, string, string][] = [
        ['actual', 'hours-actual', ''],
        ['planned', 'hours-planned', 'P: '],
        ['credit', 'hours-credit', 'C: '],
        ['creditPlanned', 'hours-credit-planned', 'PC: '],
      ];

      function updateDashboardAndCalendar() {
        const hoursByDay: Record<number, DayTotals> = {};
        const month: DayTotals = { actual: 0, planned: 0, credit: 0, creditPlanned: 0 };
        logs.forEach(log => {
          const day = parseInt(log.date.split('-')[2], 10);
          if (!hoursByDay[day]) hoursByDay[day] = { actual: 0, planned: 0, credit: 0, creditPlanned: 0 };
          const key = totalsKey(log);
          hoursByDay[day][key] += log.hours || 0;
          month[key] += log.hours || 0;
        });
        monthTotalValue.textContent = String(month.actual + month.credit);
        monthTotalSub.textContent = `${month.actual}h ministry · ${month.credit}h credit`;
        monthPlannedValue.textContent = String(month.planned + month.creditPlanned);
        monthPlannedSub.textContent = `${month.planned}h ministry · ${month.creditPlanned}h credit`;
        calendarGrid.querySelectorAll('.day-box[data-day]').forEach(dayBox => {
          const day = parseInt((dayBox as HTMLElement).dataset.day!, 10);
          const data = hoursByDay[day];
          if (!dayBox.querySelector('.day-number')) return;
          dayBox.querySelectorAll('.hours-actual, .hours-planned, .hours-credit, .hours-credit-planned').forEach(n => n.remove());
          if (!data) return;
          PILLS.forEach(([key, className, prefix]) => {
            if (data[key] > 0) dayBox.append(el('div', className, `${prefix}${data[key]}h`));
          });
        });
      }

      // --- MONTH HEADER & GRID ---
      function goToMonth(search: string) {
        (window as any).__showNavProgress?.();
        location.search = search;
      }

      function renderMonthHeader() {
        const name = new Date(currentYear, currentMonth, 1).toLocaleString('default', { month: 'long' });
        document.getElementById('monthLabel')!.textContent = `${name} ${currentYear}`;
        document.getElementById('entriesMonth')!.textContent = name;
        document.title = `${name} ${currentYear} · Planner`;
        document.getElementById('yearPlanTitle')!.textContent = `Plan hours for ${currentYear}`;

        const prev = new Date(currentYear, currentMonth - 1, 1);
        const next = new Date(currentYear, currentMonth + 1, 1);
        document.getElementById('prevMonthBtn')!.addEventListener('click', () =>
          goToMonth(`?month=${prev.getMonth()}&year=${prev.getFullYear()}`));
        document.getElementById('nextMonthBtn')!.addEventListener('click', () =>
          goToMonth(`?month=${next.getMonth()}&year=${next.getFullYear()}`));
        const todayBtn = document.getElementById('todayBtn') as HTMLButtonElement;
        todayBtn.hidden = isCurrentMonth;
        todayBtn.addEventListener('click', () => goToMonth(''));
      }

      // Empty day boxes; updateDashboardAndCalendar() adds the hour pills.
      function renderCalendarGrid() {
        const firstDayIndex = new Date(currentYear, currentMonth, 1).getDay();
        const boxes: HTMLElement[] = [];
        for (let i = 0; i < firstDayIndex; i++) {
          const blank = el('div', 'day-box');
          blank.style.cssText = 'background: #09090b; cursor: default;';
          boxes.push(blank);
        }
        for (let day = 1; day <= daysInMonth; day++) {
          const box = el('div', 'day-box');
          box.dataset.day = String(day);
          const isToday = isCurrentMonth && day === now.getDate();
          box.append(el('span', `day-number${isToday ? ' today' : ''}`, String(day)));
          boxes.push(box);
        }
        calendarGrid.replaceChildren(...boxes);
      }

      // --- FAB & ENTRY MODAL ---
      function updateStepperDisplay() {
        stepperValue.textContent = `${modalHours}h`;
        hourChips.querySelectorAll<HTMLButtonElement>('.hour-chip').forEach(chip => {
          chip.classList.toggle('active', Number(chip.dataset.hours) === modalHours);
        });
      }

      // Fill the form from an existing entry, or reset it for a new one.
      function loadEntryIntoForm(entry: PlannerLog | undefined) {
        editingLogId = entry?.id ?? null;
        modalHours = entry?.hours || 0;
        modalNotes.value = entry?.notes || '';
        modalPlanned.checked = entry?.is_planned ?? false;
        modalDeleteBtn.style.display = entry ? 'block' : 'none';
        kindToggle.querySelectorAll<HTMLButtonElement>('.kind-option').forEach(btn => {
          btn.setAttribute('aria-pressed', String(btn.dataset.kind === modalKind));
        });
        updateStepperDisplay();
      }

      // The sheet edits one entry of the selected kind for the date. A card tap passes
      // its log id so that exact entry opens (a day can hold several entries).
      function findEntryFor(kind: EntryKind) {
        if (openedLog?.kind === kind) return openedLog;
        return logs.find(log => log.date === selectedDate && (log.kind ?? 'hours') === kind);
      }

      function openEntryModal(dateStr: string, logId?: string) {
        selectedDate = dateStr;
        openedLog = (logId && logs.find(log => log.id === logId)) || null;
        modalKind = openedLog?.kind ?? 'hours';
        loadEntryIntoForm(findEntryFor(modalKind));

        modalDateLabel.textContent = new Date(dateStr).toLocaleDateString('en-AU', {
          timeZone: 'UTC', weekday: 'short', day: 'numeric', month: 'long', year: 'numeric'
        });
        entryModalOverlay.classList.add('open');
        entryModal.classList.add('open');
      }

      function closeEntryModal() {
        entryModalOverlay.classList.remove('open');
        entryModal.classList.remove('open');
        editingLogId = null;
        openedLog = null;
        modalHours = 0;
      }

      kindToggle.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.kind-option');
        const kind = btn?.dataset.kind as EntryKind | undefined;
        if (!kind || kind === modalKind) return;
        modalKind = kind;
        loadEntryIntoForm(findEntryFor(kind));
      });

      // Tapping a day selects it for the + button.
      calendarGrid.addEventListener('click', e => {
        const box = (e.target as HTMLElement).closest<HTMLElement>('.day-box[data-day]');
        if (box) selectedDate = `${monthPrefix}-${pad(Number(box.dataset.day))}`;
      });

      fab.addEventListener('click', () => openEntryModal(selectedDate));

      stepperMinus.addEventListener('click', () => {
        if (modalHours > 0) {
          modalHours = Math.round((modalHours - 0.5) * 10) / 10;
          updateStepperDisplay();
        }
      });
      stepperPlus.addEventListener('click', () => {
        modalHours = Math.round((modalHours + 0.5) * 10) / 10;
        updateStepperDisplay();
      });
      hourChips.addEventListener('click', (e) => {
        const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('.hour-chip');
        if (!chip) return;
        modalHours = Number(chip.dataset.hours);
        updateStepperDisplay();
      });

      entryModalOverlay.addEventListener('click', closeEntryModal);
      modalCloseBtn.addEventListener('click', closeEntryModal);

      modalDeleteBtn.addEventListener('click', () => {
        if (!editingLogId) return;
        logIdToDelete = editingLogId;
        closeEntryModal();
        deleteModal.style.display = 'flex';
      });

      modalSaveBtn.addEventListener('click', async () => {
        const currentEditingLogId = editingLogId;
        const payload = {
          date: selectedDate,
          hours: modalHours,
          notes: modalNotes.value,
          is_planned: modalPlanned.checked,
          kind: modalKind,
        };

        let result;
        if (currentEditingLogId) {
          result = await supabase.from('planner_logs').update(payload).eq('id', currentEditingLogId).select().single();
        } else {
          result = await supabase.from('planner_logs').insert(payload).select().single();
        }

        const { data: newOrUpdatedLog, error } = result;
        if (error) {
          showToast(`Error: ${error.message}`, 'error');
        } else if (newOrUpdatedLog) {
          const isDifferentMonth = !newOrUpdatedLog.date.startsWith(monthPrefix);
          if (isDifferentMonth) {
            location.reload();
          } else {
            if (currentEditingLogId) {
              const index = logs.findIndex(log => log.id === currentEditingLogId);
              if (index !== -1) logs[index] = newOrUpdatedLog;
            } else {
              logs.push(newOrUpdatedLog);
            }
            showToast(currentEditingLogId ? 'Log updated successfully.' : 'Log saved successfully.');
            renderLogList();
            updateDashboardAndCalendar();
            closeEntryModal();
          }
        }
      });

      // --- YEAR PLAN (bulk "select days") ---
      const MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

      function isoOf(y: number, m: number, d: number) {
        return `${y}-${String(m + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
      }

      function renderYearPlanGrid() {
        yearPlanGrid.innerHTML = MONTH_NAMES.map((name, m) => {
          const first = new Date(currentYear, m, 1).getDay();
          const total = new Date(currentYear, m + 1, 0).getDate();
          let cells = '';
          for (let i = 0; i < first; i++) cells += '<div></div>';
          for (let d = 1; d <= total; d++) {
            const iso = isoOf(currentYear, m, d);
            const classes = ['mini-day'];
            if (yearPlanSelected.has(iso)) classes.push('selected');
            else if (yearPlanExisting.has(iso)) classes.push('has-existing');
            cells += `<div class="${classes.join(' ')}" data-iso="${iso}">${d}</div>`;
          }
          return `<div class="mini-month"><div class="mini-month-label">${name}</div><div class="mini-month-grid">${cells}</div></div>`;
        }).join('');
      }

      function updateYearPlanFooter() {
        const count = yearPlanSelected.size;
        yearPlanCount.textContent = `${count} day${count === 1 ? '' : 's'} selected`;
        yearPlanSubmitBtn.textContent = count ? `Plan ${count} day${count === 1 ? '' : 's'}` : 'Plan days';
        yearPlanSubmitBtn.disabled = count === 0;
      }

      function updateYearPlanHoursDisplay() {
        yearPlanHoursValue.textContent = `${yearPlanHours}h`;
      }

      async function openYearPlanSheet() {
        if (!yearPlanLoaded) {
          const { data, error } = await supabase
            .from('planner_logs')
            .select('date')
            .eq('is_planned', true)
            .eq('kind', 'hours')
            .gte('date', `${currentYear}-01-01`)
            .lte('date', `${currentYear}-12-31`);
          if (!error && data) {
            yearPlanExisting = new Set(data.map((row: { date: string }) => row.date));
          }
          yearPlanLoaded = true;
        }
        renderYearPlanGrid();
        updateYearPlanFooter();
        updateYearPlanHoursDisplay();
        yearPlanOverlay.classList.add('open');
        yearPlanSheet.classList.add('open');
      }

      function closeYearPlanSheet() {
        yearPlanOverlay.classList.remove('open');
        yearPlanSheet.classList.remove('open');
      }

      // --- SWIPE DOWN TO CLOSE (both sheets) ---
      // Dragging the grabber/header moves the sheet with the finger; releasing
      // past a third of its height (or a quick downward flick) closes it,
      // otherwise it springs back. The scrollable body is deliberately excluded.
      function enableDragToClose(sheet: HTMLElement, overlay: HTMLElement, close: () => void) {
        const handles = sheet.querySelectorAll<HTMLElement>('.entry-modal-grabber, .entry-modal-header');
        let pointerId: number | null = null;
        let startY = 0;
        let startTime = 0;
        let dy = 0;

        handles.forEach(handle => {
          handle.addEventListener('pointerdown', (e) => {
            if (pointerId !== null || (e.target as HTMLElement).closest('button')) return;
            pointerId = e.pointerId;
            startY = e.clientY;
            startTime = performance.now();
            dy = 0;
            sheet.style.transition = 'none';
            handle.setPointerCapture(e.pointerId);
          });

          handle.addEventListener('pointermove', (e) => {
            if (e.pointerId !== pointerId) return;
            dy = Math.max(0, e.clientY - startY);
            sheet.style.transform = `translateY(${dy}px)`;
            overlay.style.opacity = String(Math.max(0, 1 - dy / sheet.offsetHeight));
          });

          const endDrag = (e: PointerEvent) => {
            if (e.pointerId !== pointerId) return;
            pointerId = null;
            const velocity = dy / Math.max(1, performance.now() - startTime); // px/ms
            const shouldClose = dy > sheet.offsetHeight / 3 || (velocity > 0.5 && dy > 20);
            // Restore the CSS transition, then hand transform back to the .open class
            // (or to the closed state) so it animates from the dragged position.
            sheet.style.transition = '';
            sheet.style.transform = '';
            overlay.style.opacity = '';
            if (shouldClose) close();
          };
          handle.addEventListener('pointerup', endDrag);
          handle.addEventListener('pointercancel', endDrag);
        });
      }

      enableDragToClose(entryModal, entryModalOverlay, closeEntryModal);
      enableDragToClose(yearPlanSheet, yearPlanOverlay, closeYearPlanSheet);

      planYearBtn.addEventListener('click', openYearPlanSheet);
      yearPlanCloseBtn.addEventListener('click', closeYearPlanSheet);
      yearPlanOverlay.addEventListener('click', closeYearPlanSheet);

      yearPlanGrid.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const cell = target.closest('.mini-day') as HTMLElement | null;
        if (!cell) return;
        const iso = cell.dataset.iso;
        if (!iso) return;
        if (yearPlanSelected.has(iso)) yearPlanSelected.delete(iso);
        else yearPlanSelected.add(iso);
        renderYearPlanGrid();
        updateYearPlanFooter();
      });

      yearPlanHoursMinus.addEventListener('click', () => {
        yearPlanHours = Math.max(0.5, Math.round((yearPlanHours - 0.5) * 10) / 10);
        updateYearPlanHoursDisplay();
      });
      yearPlanHoursPlus.addEventListener('click', () => {
        yearPlanHours = Math.round((yearPlanHours + 0.5) * 10) / 10;
        updateYearPlanHoursDisplay();
      });

      yearPlanSubmitBtn.addEventListener('click', async () => {
        const dates = [...yearPlanSelected];
        if (!dates.length) return;

        yearPlanSubmitBtn.disabled = true;
        yearPlanSubmitBtn.textContent = 'Planning…';

        // Delete-then-insert (not upsert) — see design_handoff_visits_map_year_planning/HANDOFF.md §B1.
        // Only ever touches is_planned = true rows for the exact dates selected; actual logged hours
        // (is_planned = false) are never in scope, so they can never be overwritten by this.
        // Year planning is for ministry hours only, so planned credit is never touched either.
        const { error: deleteError } = await supabase
          .from('planner_logs')
          .delete()
          .eq('is_planned', true)
          .eq('kind', 'hours')
          .in('date', dates);

        if (deleteError) {
          showToast(`Error: ${deleteError.message}`, 'error');
          updateYearPlanFooter();
          return;
        }

        const { error: insertError } = await supabase
          .from('planner_logs')
          .insert(dates.map(date => ({ date, hours: yearPlanHours, is_planned: true, notes: '', kind: 'hours' })));

        if (insertError) {
          showToast(`Error: ${insertError.message}`, 'error');
          updateYearPlanFooter();
          return;
        }

        showToast(`Planned ${dates.length} day${dates.length === 1 ? '' : 's'}.`);
        yearPlanSelected = new Set();
        yearPlanLoaded = false;
        closeYearPlanSheet();
        location.reload();
      });

      // --- ENTRY CARDS: tap opens that entry in the day sheet (edit/delete live there) ---
      logListContainer.addEventListener('click', e => {
        const card = (e.target as HTMLElement).closest<HTMLButtonElement>('.entry-card');
        const log = card && logs.find(l => l.id === card.dataset.id);
        if (log) openEntryModal(log.date, log.id);
      });

      // --- DELETE MODAL ---
      function closeDeleteModal() {
        deleteModal.style.display = 'none';
        logIdToDelete = null;
      }
      cancelDeleteBtn.addEventListener('click', closeDeleteModal);
      deleteModal.addEventListener('click', (e) => { if (e.target === deleteModal) closeDeleteModal(); });
      confirmDeleteBtn.addEventListener('click', async () => {
        if (!logIdToDelete) return;
        const { error } = await supabase.from('planner_logs').delete().eq('id', logIdToDelete);
        if (error) {
          showToast("Error: " + error.message, 'error');
        } else {
          showToast('Log entry deleted successfully.');
          logs = logs.filter(log => log.id !== logIdToDelete);
          renderLogList();
          updateDashboardAndCalendar();
        }
        closeDeleteModal();
      });

      // --- INITIAL LOAD ---
      renderMonthHeader();
      renderCalendarGrid();

      const session = await getBrowserSession();
      if (!session) return; // redirecting to /login
      supabase = session.db;

      const { data, error } = await supabase
        .from('planner_logs')
        .select('*')
        .gte('date', `${monthPrefix}-01`)
        .lte('date', `${monthPrefix}-${pad(daysInMonth)}`)
        .order('date', { ascending: false });
      if (error) {
        console.error('PLANNER_FETCH_ERROR:', error);
        showToast("Couldn't load your entries. Reload to try again.", 'error');
      }
      logs = data ?? [];
      renderLogList();
      updateDashboardAndCalendar();
    });
