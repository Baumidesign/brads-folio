---
import BottomNav from '../../components/BottomNav.astro';
import { VisitsScreen } from '../../components/visits/VisitsScreen';

// Static page served from Netlify's CDN. Auth and data loading happen in the
// browser (see src/lib/browserSession.ts), which skips a slow round trip
// through the US-based Netlify function on every visit.
export const prerender = true;
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Visits</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; }
    body {
      background: #000000;
      color: #ffffff;
      font-family: -apple-system, "SF Pro Text", system-ui, sans-serif;
      min-height: 100vh;
      padding-top: 16px;
      padding-bottom: 96px;
    }
  </style>
</head>
<body>
  <VisitsScreen client:load />
  <BottomNav />
</body>
</html>
