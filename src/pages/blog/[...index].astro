---
// Blog listing at /blog/. Written as a rest route so the page is only built
// when at least one post is published: with no posts, getStaticPaths returns
// nothing and /blog/ is a 404 (and stays out of the sitemap).
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Hero from '../../components/Hero.astro';
import { formatDate, getPosts } from '../../lib/blog';

export const prerender = true;

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.length ? [{ params: { index: undefined } }] : [];
}

const posts = await getPosts();
---

<BaseLayout
	title="Blog | Bradley Baumann"
	description="Notes on calibration software, ISO/IEC 17025 and moving labs off ageing systems, by Bradley Baumann."
	rss="/blog/rss.xml"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Blog"
				tagline="Notes on calibration software, ISO/IEC 17025 and moving labs off ageing systems."
				align="start"
			/>
			<ul class="posts">
				{
					posts.map((post) => (
						<li>
							<a class="post" href={`/blog/${post.id}/`} data-umami-event="blog-card" data-umami-event-post={post.id}>
								<time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
								<span class="title">
									{post.data.title}
									{post.data.draft && <span class="draft">Draft</span>}
								</span>
								<span class="summary">{post.data.description}</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.posts {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 46rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1.25rem;
		background: var(--gray-999);
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		transition: box-shadow var(--theme-transition);
	}

	.post:hover,
	.post:focus-visible {
		box-shadow: var(--shadow-md);
	}

	.post:focus-visible {
		outline: 2px solid var(--accent-regular);
		outline-offset: 3px;
	}

	time {
		font-size: var(--text-sm);
		color: var(--gray-400);
	}

	.title {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 600;
		line-height: 1.25;
		color: var(--gray-0);
	}

	.summary {
		color: var(--gray-300);
		line-height: 1.5;
	}

	.draft {
		margin-inline-start: 0.5rem;
		padding: 0.1em 0.5em;
		border-radius: 0.35em;
		background: #fff1a8;
		color: #5a4300;
		font-size: var(--text-sm);
		vertical-align: middle;
	}

	@media (min-width: 50em) {
		.post {
			padding: 2rem;
		}

		.title {
			font-size: var(--text-xl);
		}
	}
</style>
