---
// Landing page for invite and password-reset emails. The email templates link here
// with ?token_hash=…&type=invite|recovery. Nothing is verified on page load — the
// token is only used when the form posts to /api/auth/set-password.
const tokenHash = Astro.url.searchParams.get('token_hash');
const type = Astro.url.searchParams.get('type');
const error = Astro.url.searchParams.get('error');

if (!tokenHash || (type !== 'invite' && type !== 'recovery')) {
  return Astro.redirect('/login?error=That link is invalid. Ask for a new one.');
}

const isInvite = type === 'invite';
---

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <title>{isInvite ? 'Accept invite' : 'Reset password'} · Yo Planner</title>
  <style>
    body { background: #09090b; color: #fafafa; font-family: system-ui, -apple-system, sans-serif; display: grid; place-content: center; min-height: 100vh; margin: 0; padding: 1rem; box-sizing: border-box; }
    .login-card { background: #18181b; border: 1px solid #27272a; padding: 2.5rem; border-radius: 12px; width: 350px; max-width: 100%; box-sizing: border-box; }
    h1 { text-align: center; margin-top: 0; }
    .intro { color: #a1a1aa; text-align: center; margin: -0.5rem 0 1.5rem; font-size: 0.95rem; }
    form { display: flex; flex-direction: column; gap: 1rem; }
    label { font-size: 0.9rem; color: #a1a1aa; }
    form > div { display: flex; flex-direction: column; gap: 0.25rem; }
    input { padding: 0.8rem; border-radius: 6px; border: 1px solid #3f3f46; background: #09090b; color: white; font-family: inherit; font-size: 1rem; }
    button { padding: 0.8rem; border-radius: 6px; border: none; background: #2563eb; color: white; font-weight: bold; cursor: pointer; transition: 0.2s; font-size: 1rem; }
    button:hover { background: #1d4ed8; }
    .error-message { background: #ef444420; border: 1px solid #ef4444; color: #fca5a5; padding: 0.8rem; border-radius: 6px; text-align: center; margin-top: 1.5rem; }
  </style>
</head>
<body>
  <div class="login-card">
    <h1>{isInvite ? 'Welcome to Yo Planner' : 'Reset your password'}</h1>
    <p class="intro">{isInvite ? 'Choose a password to finish setting up your account.' : 'Choose a new password.'}</p>
    <form method="post" action="/api/auth/set-password">
      <input type="hidden" name="token_hash" value={tokenHash} />
      <input type="hidden" name="type" value={type} />
      <div>
        <label for="password">New password</label>
        <input type="password" id="password" name="password" minlength="8" autocomplete="new-password" required />
      </div>
      <div>
        <label for="confirm">Confirm password</label>
        <input type="password" id="confirm" name="confirm" minlength="8" autocomplete="new-password" required />
      </div>
      <button type="submit">{isInvite ? 'Set password & continue' : 'Save new password'}</button>
    </form>
    {error && <div class="error-message">{error}</div>}
  </div>
</body>
</html>
