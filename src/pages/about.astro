---
import BaseLayout from "../layouts/BaseLayout.astro";

import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";
import PhotoScatter from "../components/PhotoScatter.astro";
import { graph, person } from "../lib/seo";
---

<BaseLayout
  title="About | Bradley Baumann"
  description="About Bradley Baumann — building software for calibration and compliance-driven businesses"
  jsonLd={graph({ "@type": "ProfilePage", mainEntity: { "@id": person["@id"] } }, person)}
>
  <div class="stack gap-20">
    <main class="wrapper about">
      <Hero
        title="About"
        tagline="Currently building a calibration management system, with a background in UX design and freelance web development."
      >
        <img
          width="1553"
          height="873"
          src="/assets/workspace.jpg"
          alt="Bradley Baumann at work with a colleague"
        />
       
      </Hero>

      <section>
        <h2 class="section-title">Hi, I'm Brad</h2>
        <div class="content">
          <p>
            I'm a developer based in Adelaide. I build software for calibration labs and compliance-driven businesses:
            the systems behind instrument records, bench worksheets and certificates. Alongside that, I take on custom
            web applications and websites for clients across Australia and overseas.
          </p>
        </div>
      </section>
      <section>
        <h2 class="section-title">How I can help</h2>
        <div class="content">
          <p>
            <b>Calibration lab experience</b>
            <br />
            I work inside a NATA-accredited calibration lab, so I know the workflows first-hand and you won't have to
            explain them from scratch.
          </p>
          <br />
          <p>
            <b>Compliance processes</b>
            <br />
            I understand the ISO/IEC 17025 processes your records need to support, like audit trails, traceability and
            controlled changes.
          </p>
          <br />
          <p>
            <b>Database design</b>
            <br />
            Records that stay structured and consistent as they grow.
          </p>
          <br />
          <p>
            <b>UX design</b>
            <br />
            Software that's easier to learn and quicker to use for the people entering data every day.
          </p>
          <br />
          <p>
            <b>Full-stack development</b>
            <br />
            One person responsible for the whole system, from the database to the screen.
          </p>
          <br />
          <p>
            If you're working around an ageing system or a pile of spreadsheets, get in touch at
            <a href="mailto:hi@bradbaumi.com.au" data-umami-event="email-link" data-umami-event-location="about">hi@bradbaumi.com.au</a>
            or on
            <a href="https://www.linkedin.com/in/bradley-baumann-7069b231/" target="_blank" data-umami-event="linkedin" data-umami-event-location="about">LinkedIn</a>.
          </p>
        </div>
      </section>
      <section>
        <h2 class="section-title">Background</h2>
        <div class="content">
          <p>
            I work at a calibration company, where I moved the lab off a 10-year-old Access database onto Power
            Platform. I'm now rebuilding it as a custom web app, commissioned by my employer.
            <a href="/work/calibration-software/" data-umami-event="about-case-study">Read the case study →</a>
          </p>

          <br />
          <p>
            Before that, I was a UX Designer at <a href="https://www.jw.org" target="_blank">JW.ORG</a>, working
            within a team of 10 to design web applications and static sites for a nonprofit organisation with one of
            the world's most widely translated websites — a role that meant following a rigorous SDLC to serve a
            large, diverse set of stakeholders.
          </p>
          <br />
          <p>
            Since 2015 I've run my own freelance web business, building and looking after websites for clients
            in Australia and South Africa.
          </p>
        </div>
      </section>
      <section>
        <h2 class="section-title">Outside work</h2>
        <div class="content">
          <p>
            When I'm not at a keyboard, my wife and I are usually planning the next overnight hike or trip away. A few
            favourites:
          </p>
          <PhotoScatter />
        </div>
      </section>
      <section>
        <h2 class="section-title">Education</h2>
        <div class="content">
          <p>
            <b>Cape Peninsula University of Technology</b>
            <br />
            2013 National Diploma: 3 year course in Multimedia Web Development
          </p>
        </div>
      </section>
      <section>
        <h2 class="section-title">Skills</h2>
        <div class="content">
          <p>
            <b>Programming Languages</b>
            <br />
            JavaScript, TypeScript, HTML, CSS, PHP
          </p>
          <br />
          <p>
            <b>Frameworks & Libraries</b>
            <br />
            React, Astro, Next.js, Angular, Tailwind CSS
          </p>
          <br />
          <p>
            <b>Data & Backend</b>
            <br />
            PostgreSQL, Power Platform / Dataverse
          </p>
          <br />
          <p>
            <b>Also comfortable with</b>
            <br />
            Figma, Adobe XD, Photoshop, Git, Netlify, WordPress
          </p>
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  img {
    margin-top: 1.5rem;
    border-radius: 1.5rem;
    box-shadow: var(--shadow-md);
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--gray-200);
  }

  .section-title {
    grid-column-start: 1;
    font-size: var(--text-xl);
    color: var(--gray-0);
  }

  .content {
    grid-column: 2 / 4;
  }

  .content :global(a) {
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  .content :global(a:hover),
  .content :global(a:focus) {
    text-decoration-color: currentColor;
  }

  @media (min-width: 50em) {
    .about {
      display: grid;
      grid-template-columns: 1fr 60% 1fr;
    }

    .about > :global(:first-child) {
      grid-column-start: 2;
    }

    section {
      display: contents;
      font-size: var(--text-lg);
    }
  }
</style>
