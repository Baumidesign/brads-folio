---
import BaseLayout from "../layouts/BaseLayout.astro";

import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";
---

<BaseLayout
  title="About | Bradley Baumann"
  description="About Bradley Baumann — building software for calibration and compliance-driven businesses"
>
  <div class="stack gap-20">
    <main class="wrapper about">
      <Hero
        title="About"
        tagline="Currently building a calibration management system, with a background in UX design and freelance web development."
      >
        <img
          width="1553"
          height="873"
          src="/assets/workspace.jpg"
          alt="Bradley Baumann at work with a colleague"
        />
       
      </Hero>

      <section>
        <h2 class="section-title">Welcome</h2>
        <div class="content">
          <p>
            I currently work at a calibration company, where I designed and built the organisation's IT systems — a
            Power Platform backend, custom PCF tooling, and the workflows that run their calibration and compliance
            processes. I'm currently rebuilding that system from the ground up — commissioned by my employer —
            using React, Supabase, and TypeScript.
          </p>
          <br />
          <p>
            Before that, I was a UX Designer at <a href="https://www.jw.org" target="_blank">JW.ORG</a>, working
            within a team of 10 to design web applications and static sites for a nonprofit organisation with one of
            the world's most widely translated websites — a role that meant following a rigorous SDLC to serve a
            large, diverse set of stakeholders.
          </p>
          <br />
          <p>
            Alongside my current work, I take on freelance development projects—from custom web applications to
            high-performance marketing and e-commerce sites. If you have a project in mind, feel free to reach out
            via hi@bradbaumi.com.au or
            <a href="https://www.linkedin.com/in/bradley-baumann-7069b231/" target="_blank">LinkedIn</a>.
          </p>
        </div>
      </section>
      <section>
        <h2 class="section-title">Education</h2>
        <div class="content">
          <p>
            <b>Cape Peninsula University of Technology</b>
            <br />
            2013 National Diploma: 3 year course in Multimedia Web Development
          </p>
        </div>
      </section>
      <section>
        <h2 class="section-title">Skills</h2>
        <div class="content">
          <p>
            <b>Programming Languages</b>
            <br />
            JavaScript, TypeScript, HTML, CSS, PHP
          </p>
          <br />
          <p>
            <b>Frameworks & Libraries</b>
            <br />
            React, Astro, Next.js, Angular, Tailwind CSS
          </p>
          <br />
          <p>
            <b>Data & Backend</b>
            <br />
            Supabase, PostgreSQL, Power Platform / Dataverse
          </p>
          <br />
          <p>
            <b>Also comfortable with</b>
            <br />
            Figma, Adobe XD, Photoshop, Git, Netlify, WordPress
          </p>
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  img {
    margin-top: 1.5rem;
    border-radius: 1.5rem;
    box-shadow: var(--shadow-md);
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--gray-200);
  }

  .section-title {
    grid-column-start: 1;
    font-size: var(--text-xl);
    color: var(--gray-0);
  }

  .content {
    grid-column: 2 / 4;
  }

  .content :global(a) {
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  .content :global(a:hover),
  .content :global(a:focus) {
    text-decoration-color: currentColor;
  }

  @media (min-width: 50em) {
    .about {
      display: grid;
      grid-template-columns: 1fr 60% 1fr;
    }

    .about > :global(:first-child) {
      grid-column-start: 2;
    }

    section {
      display: contents;
      font-size: var(--text-lg);
    }
  }
</style>
