---
import { getCollection } from 'astro:content';

// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Component Imports
import CallToAction from '../components/CallToAction.astro';
import { graph, person, website } from '../lib/seo';
import GaugeRecord from '../components/GaugeRecord.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import FeaturedProject from '../components/FeaturedProject.astro';

// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import ServicesBento from '../components/ServicesBento.astro';
import Skills from '../components/Skills.astro';

// Content Fetching: the featured project gets a full-width card, then up to
// four of the most recent other projects
const allProjects = (await getCollection('work', (e) => !e.data.draft)).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const featured = allProjects.find((p) => p.data.featured);
const projects = allProjects.filter((p) => p !== featured).slice(0, 3);

// Full Astro Component Syntax:
// https://docs.astro.build/core-concepts/astro-components/
---

<BaseLayout
	title="Bradley Baumann — Full-Stack Developer, Adelaide"
	description="Full-stack developer based in Adelaide, South Australia, specialising in calibration and compliance management systems for regulated industries."
	jsonLd={graph(person, website)}
>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero
					eyebrow="Bradley Baumann"
					avatar="/assets/avatar.webp"
					title="Software for Calibration & Compliance Businesses"
					titleHtml="Software for Calibration <span class='force-break'>&amp; Compliance Businesses</span>"
					tagline="I specialise in calibration and internal management systems, where data integrity and user experience both have to be right. I also take on custom web applications and freelance work."
					align="start"
				>
					<p class="location">Based in Adelaide, South Australia · Working with clients in Australia and overseas</p>
				</Hero>

				<GaugeRecord href="/work/calibration-software/" />
			</header>

			<Skills />
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Selected Work</h3>
					<p>My current calibration systems work, alongside past client and freelance web projects.</p>
				</header>

				<div class="gallery stack gap-15">
					{featured && <FeaturedProject project={featured} lazy headingLevel={4} compact />}
					<Grid variant="trio">
						{
							projects.map((project) => (
								<li>
									<PortfolioPreview project={project} />
								</li>
							))
						}
					</Grid>
				</div>

				<div class="cta">
					<CallToAction href="/work/">
						View All
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>

			<section class="section with-background bg-variant">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Services</h3>
					<p>Alongside my calibration systems work, I take on freelance web development — from full builds to fixing what's already there.</p>
				</header>

				<div class="gallery">
					<ServicesBento />
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.location {
		margin-top: 0.75rem;
		font-size: var(--text-sm);
		color: var(--gray-400);
	}

	/* The value-prop H1 here is much longer than the short titles Hero.astro
	   is otherwise used with (e.g. "About"), so it's sized down from the
	   component's shared default — scoped to this page only. */
	.hero :global(.title) {
		font-size: var(--text-2xl);
	}

	/* More air between eyebrow, headline and subhead on this page */
	.hero :global(.tagline) {
		margin-top: 0.75rem;
	}

	/* Natural wrapping on mobile — the forced break only kicks in at the
	   desktop breakpoint below. */
	.hero :global(.force-break) {
		display: inline;
	}

	@media (min-width: 50em) {
		.hero :global(.title) {
			font-size: var(--text-3xl);
		}

		.hero :global(.force-break) {
			display: block;
		}
	}

	/* Two columns only once there's room for both the H1 and the gauge card
	   side by side; below this the card stacks under the copy. */
	@media (min-width: 64em) {
		.hero {
			display: grid;
			/* ~55/45 text to card; tops aligned so nothing floats above the H1 */
			grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
			align-items: start;
			gap: 5rem;
		}

		.hero > :global(.gauge-record) {
			justify-self: end;
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}

</style>
