---
import { getCollection } from 'astro:content';

// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Component Imports
import CallToAction from '../components/CallToAction.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';

// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Skills from '../components/Skills.astro';

// Content Fetching: List four most recent work projects
const projects = (await getCollection('work'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

// Full Astro Component Syntax:
// https://docs.astro.build/core-concepts/astro-components/
---

<BaseLayout>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero
					eyebrow="Bradley Baumann"
					title="Building Software for Calibration & Compliance Businesses"
					tagline="I'm currently building a calibration management system — the kind of software that has to get data integrity and process rigor right. Alongside that, I take on freelance web development work."
					align="start"
				>
					<div class="roles">
						<Pill><Icon icon="pencil-line" size="1.33em" /> Design</Pill>
						<Pill><Icon icon="shapes" size="1.33em" /> Architect</Pill>
						<Pill><Icon icon="terminal-window" size="1.33em" /> Build</Pill>
					</div>
				</Hero>

				<img
					alt="A black and white portrait of Bradley Baumann"
					width="347"
					height="399"
					src="/assets/portrait-hero.png"
				/>
			</header>

			<Skills />
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Selected Work</h3>
					<p>Past client and freelance web projects. My current focus — a calibration management system I'm building now — will land here as a full case study soon.</p>
				</header>

				<div class="gallery">
					<Grid variant="offset">
						{
							projects.map((project) => (
								<li>
									<PortfolioPreview project={project} />
								</li>
							))
						}
					</Grid>
				</div>

				<div class="cta">
					<CallToAction href="/work/">
						View All
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>

			<section class="section with-background bg-variant">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Services</h3>
					<p>Alongside my calibration systems work, I take on freelance web development — from full builds to fixing what's already there.</p>
				</header>

				<div class="gallery">
					<Grid variant="small">
						{
							[
								'Full-Stack Development',
								'Systems Architecture',
								'UX & Product Design',
								'Site Migrations',
								'Technical Consulting',
							].map((brand) => (
								<li class="mention-card">
									<p>{brand}</p>
								</li>
							))
						}
					</Grid>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: none;
	}

	/* The value-prop H1 here is much longer than the short titles Hero.astro
	   is otherwise used with (e.g. "About"), so it's sized down from the
	   component's shared default — scoped to this page only. */
	.hero :global(.title) {
		font-size: var(--text-2xl);
	}

	.hero img {
		/* Matches the source file's native ratio (347x399, trimmed of a
		   transparent top margin) so object-fit has nothing to crop — the
		   image already has its own rounded-card framing baked in, so we
		   don't add a second, differently-curved border-radius on top of
		   it (that mismatch was leaving a thin gap at the corners). */
		aspect-ratio: 347 / 399;
		object-fit: contain;
		object-position: top;
		/* box-shadow casts from the <img>'s rectangular box, not the PNG's
		   transparent silhouette — with no border-radius to match it, that
		   left a faint rectangular tint behind the rounded corners.
		   drop-shadow follows the actual alpha shape instead, so the shadow
		   hugs the card (and the cap) exactly. Same 4 layers/values as
		   --shadow-md (src/styles/global.css), theme-aware. */
		filter: var(--portrait-drop-shadow);
	}

	:root:not(.theme-dark) .hero img {
		--portrait-drop-shadow: drop-shadow(0px 28px 11px rgba(9, 11, 17, 0.01))
			drop-shadow(0px 16px 10px rgba(9, 11, 17, 0.03)) drop-shadow(0px 7px 7px rgba(9, 11, 17, 0.05))
			drop-shadow(0px 2px 4px rgba(9, 11, 17, 0.06));
	}

	:root.theme-dark .hero img {
		--portrait-drop-shadow: drop-shadow(0px 28px 11px rgba(255, 255, 255, 0.01))
			drop-shadow(0px 16px 10px rgba(255, 255, 255, 0.03))
			drop-shadow(0px 7px 7px rgba(255, 255, 255, 0.05)) drop-shadow(0px 2px 4px rgba(255, 255, 255, 0.06));
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 7fr 3fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			display: flex;
			gap: 0.5rem;
		}

		.hero :global(.title) {
			font-size: var(--text-4xl);
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}

	/* ====================================================== */

	.mention-card {
		display: flex;
		height: 7rem;
		justify-content: center;
		align-items: center;
		text-align: center;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		color: var(--gray-300);
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	@media (min-width: 50em) {
		.mention-card {
			border-radius: 1.5rem;
			height: 9.5rem;
		}
	}
</style>
