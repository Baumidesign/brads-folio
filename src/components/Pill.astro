---
interface Props {
	// 'solid': the original filled style, used where a Pill is meant to read
	// as a compact label/badge with strong emphasis (e.g. work-page tags).
	// 'tag': lighter tinted style — for places a solid fill could be mistaken
	// for a clickable button, or where a quieter label reads better.
	variant?: 'solid' | 'tag';
}

const { variant = 'solid' } = Astro.props;
---

<div class:list={['pill', variant]}><slot /></div>

<style>
	.pill {
		display: flex;
		padding: 0.5rem 1rem;
		gap: 0.5rem;
		border-radius: 999rem;
		font-size: var(--text-md);
		line-height: 1.35;
		white-space: nowrap;
	}

	.solid {
		color: var(--accent-text-over);
		border: 1px solid var(--accent-regular);
		background-color: var(--accent-regular);
	}

	/* --accent-regular is the same hex in both themes, so a manual rgba
	   here stays visually consistent light/dark (the --accent-overlay
	   tokens shift hue per theme, which would read differently). */
	.tag {
		color: var(--accent-regular);
		background: rgba(66, 75, 255, 0.1);
		border: 1px solid rgba(66, 75, 255, 0.3);
	}
</style>
