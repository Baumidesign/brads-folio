---
// Long-form case study: maps the `longForm` frontmatter (see
// src/content.config.ts) onto the shared Article layout.
import type { CollectionEntry } from 'astro:content';
import Article from './Article.astro';

interface Props {
	data: CollectionEntry<'work'>['data'];
	longForm: NonNullable<CollectionEntry<'work'>['data']['longForm']>;
}

const { data, longForm } = Astro.props;

const facts = [
	data.role && { label: 'Role', value: data.role },
	longForm.timeline && { label: 'Timeline', value: longForm.timeline },
	data.techStack?.length && { label: 'Built with', value: data.techStack.join(', ') },
].filter(Boolean) as { label: string; value: string }[];
---

<Article
	eyebrow={longForm.eyebrow ?? 'Case study'}
	headline={longForm.headline}
	lede={longForm.lede ?? data.description}
	facts={facts}
	heroImg={longForm.heroImg}
	heroImgAlt={longForm.heroImg_alt}
	glance={longForm.glance}
	cta={longForm.cta}
	ctaEvent="case-study-cta"
>
	<slot />
</Article>
