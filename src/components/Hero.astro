---
interface Props {
	eyebrow?: string;
	title: string;
	// Optional raw-HTML title for cases that need an explicit break point
	// (e.g. a <span> that's forced to display:block at one breakpoint only)
	// rather than relying on natural text wrapping. Opt-in only — plain
	// `title` still renders as escaped text everywhere else.
	titleHtml?: string;
	tagline?: string;
	align?: 'start' | 'center';
	// Optional small round photo shown beside the eyebrow (decorative)
	avatar?: string;
}

const { align = 'center', avatar, eyebrow, tagline, title, titleHtml } = Astro.props;
---

<div class:list={['hero stack gap-4', align]}>
	<div class="stack gap-2">
		{
			eyebrow && (
				<p class:list={['eyebrow', { 'has-avatar': avatar }]}>
					{avatar && <img class="avatar" src={avatar} alt="" width="40" height="40" />}
					{eyebrow}
				</p>
			)
		}
		{titleHtml ? <h1 class="title" set:html={titleHtml} /> : <h1 class="title">{title}</h1>}
		{tagline && <p class="tagline">{tagline}</p>}
	</div>
	<slot />
</div>

<style>
	.hero {
		font-size: var(--text-lg);
		text-align: center;
	}

	.eyebrow,
	.title,
	.tagline {
		max-width: 37ch;
		margin-inline: auto;
	}

	.eyebrow {
		font-family: var(--font-brand);
		font-weight: 600;
		font-size: var(--text-sm);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent-regular);
	}

	.has-avatar {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.625rem;
	}

	.avatar {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		object-fit: cover;
		object-position: 50% 12%;
		box-shadow: 0 0 0 1px var(--accent-overlay);
	}

	.title {
		font-size: var(--text-3xl);
		color: var(--gray-0);
	}

	@media (min-width: 50em) {
		.hero {
			font-size: var(--text-xl);
		}

		.start {
			text-align: start;
		}

		.start .has-avatar {
			justify-content: flex-start;
		}

		.start .eyebrow,
		.start .title,
		.start .tagline {
			margin-inline: unset;
		}

		.title {
			font-size: var(--text-5xl);
		}
	}
</style>
