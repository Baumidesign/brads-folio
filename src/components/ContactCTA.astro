---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
---

<aside>
	<div class="copy">
		<p class="eyebrow">Get in Touch</p>
		<h2>Let's Talk About Your Project</h2>
		<p class="subtitle">
			Whether it's a new build, a legacy migration, or a second opinion on your architecture — I'm happy to talk
			it through.
		</p>
	</div>
	<div class="actions">
		<CallToAction href="mailto:hi@bradbaumi.com.au">
			Start a Conversation
			<Icon icon="paper-plane-tilt" size="1.2em" />
		</CallToAction>
		<p class="secondary">
			Prefer email or LinkedIn? Reach me directly at <a href="mailto:hi@bradbaumi.com.au">hi@bradbaumi.com.au</a>
			or connect on
			<a href="https://www.linkedin.com/in/bradley-baumann-7069b231/" target="_blank">LinkedIn</a>.
		</p>
	</div>
</aside>

<style>
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
		border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);
		padding: 5rem 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	.copy,
	.actions {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.eyebrow {
		font-family: var(--font-brand);
		font-weight: 600;
		font-size: var(--text-sm);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent-regular);
	}

	h2 {
		font-size: var(--text-xl);
		text-align: center;
		max-width: 18ch;
	}

	.subtitle {
		font-size: var(--text-md);
		color: var(--gray-400);
		text-align: center;
		max-width: 38ch;
	}

	.secondary {
		font-size: var(--text-sm);
		color: var(--gray-400);
		text-align: center;
		max-width: 32ch;
	}

	.secondary :global(a) {
		color: var(--gray-300);
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.secondary :global(a:hover),
	.secondary :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		aside {
			padding: 7.5rem;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
			gap: 3rem;
		}

		.copy,
		.actions {
			align-items: flex-start;
		}

		h2 {
			font-size: var(--text-3xl);
			text-align: left;
		}

		.subtitle,
		.secondary {
			text-align: left;
		}
	}
</style>
