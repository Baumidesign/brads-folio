---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, slug } = Astro.props.project;
---

<a class="card" href={`/work/${slug}`} data-umami-event="project-card" data-umami-event-project={slug}>
	<img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" />
	<span class="caption">
		<span class="text">
			<span class="title">{data.title}</span>
			{data.tags.length > 0 && <span class="tags">{data.tags.join(' · ')}</span>}
		</span>
		<span class="arrow" aria-hidden="true">→</span>
	</span>
</a>

<style>
	/* Title sits in a caption strip below the image so it never competes
	   with the image itself (light screenshots swallowed the old overlay). */
	.card {
		display: grid;
		grid-template-rows: 9rem auto;
		background: var(--gray-999);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		font-family: var(--font-brand);
		transition: box-shadow var(--theme-transition);
	}

	.card:hover {
		box-shadow: var(--shadow-md);
	}

	.card:focus-visible {
		outline: 2px solid var(--accent-regular);
		outline-offset: 3px;
	}

	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		background: var(--gradient-subtle);
	}

	.caption {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		padding: 0.875rem 1.125rem 1rem;
		border-top: 1px solid var(--gray-800);
	}

	.text {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		min-width: 0;
	}

	.title {
		font-size: var(--text-lg);
		font-weight: 500;
		color: var(--gray-0);
		overflow-wrap: anywhere;
	}

	.tags {
		font-family: var(--font-body);
		font-size: var(--text-sm);
		color: var(--gray-400);
	}

	.arrow {
		flex: none;
		font-size: var(--text-lg);
		color: var(--accent-regular);
		transition: transform 0.2s ease;
	}

	.card:hover .arrow {
		transform: translateX(4px);
	}

	@media (min-width: 50em) {
		.card {
			grid-template-rows: 17rem auto;
			border-radius: 1.5rem;
		}

		.caption {
			padding: 1rem 1.25rem 1.125rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.arrow {
			transition: none;
		}
	}
</style>
